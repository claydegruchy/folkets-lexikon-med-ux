  <ar>
    <k>järn</k>
    <def cmt="vardagligt">
      <gr>nn</gr>
      <dtrn>[wee] dram, swig</dtrn>
      <tr>jä:r_n</tr>
      <iref href="http://lexin.nada.kth.se/sound/j0344rn.mp3" />
