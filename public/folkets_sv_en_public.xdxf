      <ex type="exm"><ex_orig>det myckna regnandet</ex_orig><ex_transl>the abundant rain</ex_transl>      </ex>
      <ex type="phr"><ex_orig>tack så mycket!</ex_orig><ex_transl>thank you very much!</ex_transl></ex>
