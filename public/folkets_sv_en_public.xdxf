      <dtrn>what</dtrn>
      <tr>va:(d)</tr>
      <iref href="http://lexin.nada.kth.se/sound/vad.mp3" />
      <sr><kref type="syn">baksida av underben</kref></sr>
      <sr><kref type="syn">hur sa</kref></sr>
      <sr><kref type="syn">underben</kref></sr>
      <sr><kref type="syn">va</kref></sr>
      <ex type="exm"><ex_orig>vad är klockan?</ex_orig><ex_transl>what time is it?</ex_transl>      </ex>
      <ex type="exm"><ex_orig>vad kostar fisken?</ex_orig><ex_transl>how much is the fish?</ex_transl>      </ex>
      <ex type="exm"><ex_orig>vad heter du?</ex_orig><ex_transl>what is your name?</ex_transl>      </ex>
      <ex type="phr"><ex_orig>va (el. vadå)? (&quot;vad säger du?, hursa?&quot;)</ex_orig><ex_transl>what? (&amp;quot;what are you saying?, what do you mean?&amp;quot;)</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>vad</k>
    <def>
      <gr>pn</gr>
      <dtrn>what</dtrn>
      <tr>va:(d)</tr>
      <iref href="http://lexin.nada.kth.se/sound/vad.mp3" />
      <ex type="exm"><ex_orig>jag förstår inte vad du säger</ex_orig><ex_transl>I don&#39;t understand what you are saying</ex_transl>      </ex>
      <ex type="phr"><ex_orig>vad som helst ("allt möjligt")</ex_orig><ex_transl>whatever (&quot;anything at all&quot;)</ex_transl></ex>
      <def>det som, vilket</def>
    </def>
  </ar>
  <ar>
    <k>vad</k>
    <def>
      <gr>nn</gr>
      <dtrn>calf</dtrn>
      <tr>va:d</tr>
