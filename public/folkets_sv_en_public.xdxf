      <ex type="exm"><ex_orig>kungen är död</ex_orig><ex_transl>the king is dead</ex_transl>      </ex>
      <ex type="exm"><ex_orig>dött lopp</ex_orig><ex_transl>dead heat</ex_transl>      </ex>
      <ex type="phr"><ex_orig>stendöd</ex_orig><ex_transl>stone dead</ex_transl></ex>
