      <ex type="phr"><ex_orig>missnöjd</ex_orig><ex_transl>dissatisfied</ex_transl></ex>
      <ex type="phr"><ex_orig>misslyckas</ex_orig><ex_transl>fail</ex_transl></ex>
      <def>icke-, dålig, felaktig etc</def>
    </def>
  </ar>
  <ar>
    <k>missanpassad</k>
    <def>
      <gr>jj</gr>
      <dtrn>maladjusted</dtrn>
      <tr>²m'is:anpas:ad</tr>
      <iref href="http://lexin.nada.kth.se/sound/missanpassad.mp3" />
      <ex type="exm"><ex_orig>missanpassade barn</ex_orig><ex_transl>maladjusted children</ex_transl>      </ex>
      <def>som inte kan anpassa sig till miljön</def>
    </def>
  </ar>
  <ar>
    <k>missa</k>
    <def cmt="vardagligt även 'gå miste om (något); komma försent till'">
      <gr>vb</gr>
      <dtrn>miss</dtrn>
      <tr>²m'is:ar</tr>
      <iref href="http://lexin.nada.kth.se/sound/missar.mp3" />
      <sr><kref type="syn">bomma</kref></sr>
      <sr><kref type="syn">försitta</kref></sr>
      <sr><kref type="syn">sumpa</kref></sr>
      <sr><kref type="syn">undgå</kref></sr>
      <ex type="exm"><ex_orig>missa inte den filmen!</ex_orig><ex_transl>don&amp;#39;t miss that film!</ex_transl>      </ex>
      <ex type="exm"><ex_orig>hon missade tåget</ex_orig><ex_transl>she missed the train</ex_transl>      </ex>
      <ex type="exm"><ex_orig>missa en straff</ex_orig><ex_transl>miss a penalty</ex_transl>      </ex>
      <ex type="exm"><ex_orig>jag sköt och missade med ett par meter</ex_orig><ex_transl>I shot and missed by a couple of metres</ex_transl>      </ex>
      <def>misslyckas med att träffa ett visst mål</def>
    </def>
  </ar>
  <ar>
