      <ex type="phr"><ex_orig>vara med barn (&quot;vara gravid&quot;)</ex_orig><ex_transl>be with child (&amp;quot;be pregnant&amp;quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>till och med (t o m) (&quot;även, så mycket som&quot;)</ex_orig><ex_transl>including (&amp;quot;even, as much as&amp;quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>med hänsyn till (&quot;om man tar hänsyn till&quot;)</ex_orig><ex_transl>with regard to (&amp;quot;if one were to consider&amp;quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>med mera (m m) (&quot;och annat&quot;)</ex_orig><ex_transl>et cetera (etc.) (&amp;quot;and other things&amp;quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>med rätta (&quot;helt rättvist&quot;)</ex_orig><ex_transl>rightly (&amp;quot;justifiably&amp;quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>med tanke på (&quot;om man tänker på, med hänsyn till&quot;)</ex_orig><ex_transl>considering (&amp;quot;seeing, with a view to&amp;quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>med andra ord (&quot;på annat sätt sagt&quot;)</ex_orig><ex_transl>in other words (&amp;quot;or, one could say,&amp;quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>med anledning av (&quot;på grund av&quot;)</ex_orig><ex_transl>on account of (&amp;quot;because of&amp;quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>med avsikt (&quot;fullt medvetet&quot;)</ex_orig><ex_transl>with intent (&amp;quot;deliberately&amp;quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>med hjälp av (&quot;med (något) som hjälpmedel&quot;)</ex_orig><ex_transl>by means of (&amp;quot;with (sth.) as a tool&amp;quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>med all rätt (&quot;helt rättvist&quot;)</ex_orig><ex_transl>fully entitled to do so (&amp;quot;justly so&amp;quot;)</ex_transl></ex>
    </def>
