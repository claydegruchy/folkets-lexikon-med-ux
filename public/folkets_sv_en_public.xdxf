      <ex type="exm"><ex_orig>han kom efter det att festen hade börjat</ex_orig>      </ex>
      <ex type="exm"><ex_orig>år efter år</ex_orig><ex_transl>year after year</ex_transl>      </ex>
      <ex type="exm"><ex_orig>städa efter sig</ex_orig><ex_transl>to clean up after oneself</ex_transl>      </ex>
      <ex type="phr"><ex_orig>anpassa sig efter (någons önskemål)</ex_orig><ex_transl>adapt to (sby&#39;s wishes)</ex_transl></ex>
      <ex type="phr"><ex_orig>sjunga efter noter</ex_orig><ex_transl>sight-read</ex_transl></ex>
      <def>senare än; bakom</def>
    </def>
  </ar>
