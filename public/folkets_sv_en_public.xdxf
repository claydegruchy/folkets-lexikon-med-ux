      <sr><kref type="syn">modfälld</kref></sr>
      <sr><kref type="syn">modlös</kref></sr>
      <sr><kref type="syn">modstulen</kref></sr>
      <sr><kref type="syn">nedstämd</kref></sr>
      <sr><kref type="syn">nere</kref></sr>
