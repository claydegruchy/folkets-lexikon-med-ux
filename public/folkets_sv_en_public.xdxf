      <sr><kref type="syn">baksida av underben</kref></sr>
      <sr><kref type="syn">hur sa</kref></sr>
      <sr><kref type="syn">underben</kref></sr>
      <sr><kref type="syn">va</kref></sr>
      <ex type="exm"><ex_orig>vad snällt av dig!</ex_orig><ex_transl>how kind of you!</ex_transl>      </ex>
      <ex type="exm"><ex_orig>vad dum jag är!</ex_orig><ex_transl>how silly I am!</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>vad</k>
