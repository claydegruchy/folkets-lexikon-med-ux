      <ex type="exm"><ex_orig>här och där</ex_orig><ex_transl>all over</ex_transl>      </ex>
      <ex type="exm"><ex_orig>där borta</ex_orig><ex_transl>over there</ex_transl>      </ex>
      <ex type="exm"><ex_orig>där springer han</ex_orig><ex_transl>there he goes</ex_transl>      </ex>
      <ex type="exm"><ex_orig>en sån där bil</ex_orig><ex_transl>a car like that</ex_transl>      </ex>
      <ex type="exm"><ex_orig>den där boken</ex_orig><ex_transl>that book</ex_transl>      </ex>
      <ex type="phr"><ex_orig>-- Hur mår du? -- Så där (&quot;någorlunda&quot;)</ex_orig><ex_transl>-- How are you?-- So, so (&amp;quot;not too bad&amp;quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>Så där ja! (&quot;Det var det!&quot;)</ex_orig><ex_transl>There we go! (&amp;quot;Well, that&amp;#39;s that!&amp;quot;)</ex_transl></ex>
      <def>på det stället</def>
    </def>
  </ar>
  <ar>
    <k>där</k>
    <def>
      <gr>ab</gr>
      <dtrn>where</dtrn>
      <tr>dä:r</tr>
      <iref href="http://lexin.nada.kth.se/sound/d0344r.mp3" />
      <sr><kref type="syn">därborta</kref></sr>
      <ex type="exm"><ex_orig>där huset låg finns nu en motorväg</ex_orig><ex_transl>where the house was, there is now a motorway</ex_transl>      </ex>
      <ex type="exm"><ex_orig>huset där jag bor ska rivas</ex_orig><ex_transl>the house where I live will be torn down</ex_transl>      </ex>
      <def>på det stället som</def>
    </def>
  </ar>
  <ar>
    <k>däran</k>
    <def>
      <gr>ab</gr>
      <tr>där'an:</tr>
      <iref href="http://lexin.nada.kth.se/sound/d0344ran.mp3" />
      <ex type="phr"><ex_orig>vara illa däran (&quot;vara svårt skadad el. sjuk&quot;)</ex_orig><ex_transl>be in a bad way (&amp;quot;be seriously injured or sick&amp;quot;)</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>därborta</k>
    <def>
      <gr>ab</gr>
      <dtrn>over there</dtrn>
      <tr>²därb'år_t:a</tr>
      <iref href="http://lexin.nada.kth.se/sound/d0344rborta.mp3" />
      <sr><kref type="syn">där</kref></sr>
      <def>på det där stället</def>
    </def>
  </ar>
  <ar>
    <k>därefter</k>
    <def>
      <gr>ab</gr>
      <dtrn>afterward</dtrn>
      <dtrn>then</dtrn>
      <tr>där'ef:ter</tr>
      <iref href="http://lexin.nada.kth.se/sound/d0344refter.mp3" />
      <sr><kref type="syn">därnäst</kref></sr>
      <sr><kref type="syn">därpå</kref></sr>
      <sr><kref type="syn">efteråt</kref></sr>
      <sr><kref type="syn">närmast i följd</kref></sr>
      <sr><kref type="syn">sedan</kref></sr>
      <sr><kref type="syn">sedermera</kref></sr>
      <ex type="exm"><ex_orig>kort därefter</ex_orig><ex_transl>shortly thereafter</ex_transl>      </ex>
      <ex type="exm"><ex_orig>dagen därefter</ex_orig><ex_transl>the next day</ex_transl>      </ex>
      <def>efter detta</def>
    </def>
  </ar>
  <ar>
    <k>däremot</k>
    <def cmt="anger motsats">
      <gr>ab</gr>
      <dtrn>on the other hand</dtrn>
      <dtrn>however</dtrn>
      <tr>d'ä:remo:t</tr>
      <iref href="http://lexin.nada.kth.se/sound/d0344remot.mp3" />
      <sr><kref type="syn">å andra sidan</kref></sr>
      <sr><kref type="syn">dock</kref></sr>
      <sr><kref type="syn">fisk</kref></sr>
      <sr><kref type="syn">damaged</kref></sr>
      <ex type="exm"><ex_orig>Jag har aldrig varit i Spanien. Däremot har jag varit i Italien</ex_orig><ex_transl>I have never been in Spain; I have, however, been in Italy</ex_transl>      </ex>
      <def>emellertid; tvärtom</def>
    </def>
  </ar>
  <ar>
    <k>därför</k>
    <def>
      <gr>ab</gr>
      <dtrn>so, for that reason</dtrn>
      <tr>d'är:fö:r</tr>
      <iref href="http://lexin.nada.kth.se/sound/d0344rf0366r.mp3" />
      <sr><kref type="syn">eftersom</kref></sr>
      <sr><kref type="syn">följaktligen</kref></sr>
      <sr><kref type="syn">för den skull</kref></sr>
      <sr><kref type="syn">på grund av</kref></sr>
      <sr><kref type="syn">således</kref></sr>
      <ex type="exm"><ex_orig>Jag missade tåget därför att jag försov mig</ex_orig>      </ex>
      <ex type="exm"><ex_orig>Jag försov mig. Därför missade jag tåget</ex_orig><ex_transl>I overslept. That&amp;#39;s why I missed the train</ex_transl>      </ex>
      <def>av den orsaken, på grund av detta</def>
    </def>
  </ar>
  <ar>
    <k>därhän</k>
    <def>
      <gr>ab</gr>
      <dtrn>that far</dtrn>
      <tr>därh'ä:n</tr>
      <iref href="http://lexin.nada.kth.se/sound/d0344rh0344n.mp3" />
      <ex type="phr"><ex_orig>lämna något därhän (&quot;lämna något oavslutat&quot;)</ex_orig><ex_transl>leave sth. hanging (&amp;quot;leave sth. unfinished&amp;quot;)</ex_transl></ex>
      <def>ända dit</def>
    </def>
  </ar>
  <ar>
    <k>däri</k>
