      <gr>jj</gr>
      <dtrn>beautiful</dtrn>
      <tr>v'ak:er</tr>
      <iref href="http://lexin.nada.kth.se/sound/vacker.mp3" />
      <sr><kref type="syn">attraktiv</kref></sr>
      <sr><kref type="syn">bedårande</kref></sr>
      <sr><kref type="syn">elegant</kref></sr>
      <sr><kref type="syn">fager</kref></sr>
      <sr><kref type="syn">fal</kref></sr>
      <sr><kref type="syn">fin</kref></sr>
      <sr><kref type="syn">fint</kref></sr>
      <sr><kref type="syn">fräsch</kref></sr>
      <sr><kref type="syn">förtjusande</kref></sr>
      <sr><kref type="syn">grandios</kref></sr>
      <sr><kref type="syn">grann</kref></sr>
      <sr><kref type="syn">ljuv</kref></sr>
      <sr><kref type="syn">ljuvlig</kref></sr>
      <sr><kref type="syn">mycket fin</kref></sr>
      <sr><kref type="syn">parant</kref></sr>
      <sr><kref type="syn">skön</kref></sr>
      <sr><kref type="syn">skönhet</kref></sr>
      <sr><kref type="syn">snygg</kref></sr>
      <sr><kref type="syn">stilig</kref></sr>
      <sr><kref type="syn">tilltalande</kref></sr>
      <sr><kref type="syn">tjusig</kref></sr>
      <sr><kref type="syn">underskön</kref></sr>
      <ex type="exm"><ex_orig>en vacker flicka</ex_orig><ex_transl>a beautiful girl</ex_transl>      </ex>
      <ex type="exm"><ex_orig>vacker musik</ex_orig><ex_transl>beautiful music</ex_transl>      </ex>
      <ex type="exm"><ex_orig>vackert väder</ex_orig><ex_transl>beautiful weather</ex_transl>      </ex>
      <ex type="phr"><ex_orig>en vacker dag (&quot;en gång i framtiden (då man inte är förberedd)&quot;)</ex_orig><ex_transl>one fine day (&amp;quot;some time in the future (when one is not prepared)&amp;quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>vackert! (&quot;bra (gjort)&quot;)</ex_orig><ex_transl>well done!</ex_transl></ex>
      <def>behaglig att se el. höra</def>
    </def>
  </ar>
  <ar>
    <k>vackla</k>
