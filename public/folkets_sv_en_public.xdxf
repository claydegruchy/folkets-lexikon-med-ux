      <sr><kref type="syn">skinande</kref></sr>
      <ex type="exm"><ex_orig>en blank sida</ex_orig><ex_transl>a blank page</ex_transl>      </ex>
      <ex type="exm"><ex_orig>sjön låg blank som en spegel</ex_orig><ex_transl>the lake was as smooth as a millpond</ex_transl>      </ex>
      <ex type="exm"><ex_orig>en blank röst</ex_orig><ex_transl>a blank vote</ex_transl>      </ex>
      <ex type="phr"><ex_orig>mitt på blanka ("själva") förmiddagen</ex_orig><ex_transl>in broad daylight</ex_transl></ex>
      <ex type="phr"><ex_orig>det blev blankt nej ("klart nej") på vårt förslag</ex_orig><ex_transl>our proposal met with a flat refusal</ex_transl></ex>
      <def>glänsande, skinande; utan skrift, tom</def>
    </def>
