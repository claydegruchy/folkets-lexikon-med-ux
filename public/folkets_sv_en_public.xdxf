      <ex type="exm"><ex_orig>du är gammal nog att veta bättre</ex_orig><ex_transl>you are old enough to know better</ex_transl>      </ex>
      <ex type="exm"><ex_orig>nog så ofta</ex_orig><ex_transl>often enough</ex_transl>      </ex>
      <ex type="exm"><ex_orig>inte nog med att hon är vacker, hon är intelligent också</ex_orig><ex_transl>she is not only beautiful but intelligent as well</ex_transl>      </ex>
