      <sr><kref type="syn">otillfredsställd</kref></sr>
      <ex type="exm"><ex_orig>missbelåten med ett resultat</ex_orig><ex_transl>dissatisfied with an outcome</ex_transl>      </ex>
      <def>inte nöjd, otillfredsställd</def>
    </def>
  </ar>
  <ar>
    <k>missbildad</k>
