    <def>
      <gr>nn</gr>
      <dtrn>total abstainer</dtrn>
      <dtrn>teetotaller</dtrn>
      <tr>absolut'is:t</tr>
      <iref href="http://lexin.nada.kth.se/sound/absolutist.mp3" />
