<lexicon>
  <ar>
    <k>à</k>
    <def cmt="endast vid sifferuttryck">
      <gr>pp</gr>
      <dtrn>at</dtrn>
      <tr>a</tr>
      <iref href="http://lexin.nada.kth.se/sound/0340.mp3" />
      <ex type="exm"><ex_orig>två koppar kaffe à 8 kronor (styck)</ex_orig><ex_transl>two cups of coffee at 8 kronor (each)</ex_transl>      </ex>
      <def>till ett pris av</def>
    </def>
  </ar>
  <ar>
    <k>à</k>
    <def cmt="i sifferuttryck">
      <gr>pp</gr>
      <dtrn>to</dtrn>
      <tr>a</tr>
      <iref href="http://lexin.nada.kth.se/sound/0340.mp3" />
      <ex type="exm"><ex_orig>2 à 3 meter</ex_orig><ex_transl>2 to 3 metres</ex_transl>      </ex>
      <def>till</def>
    </def>
  </ar>
  <ar>
    <k>a</k>
    <def>
      <gr>nn</gr>
      <dtrn>a</dtrn>
      <tr>a:</tr>
      <iref href="http://lexin.nada.kth.se/sound/a.mp3" />
      <ex type="phr"><ex_orig>har man sagt a får man också säga b (&quot;har man börjat får man fortsätta&quot;)</ex_orig><ex_transl>in for a penny, in for a pound (&amp;quot;what you start you must finish off&amp;quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>a och o (&quot;det viktigaste&quot;)</ex_orig><ex_transl>alpha and omega</ex_transl></ex>
      <def>första bokstaven i alfabetet</def>
    </def>
  </ar>
  <ar>
    <k>a</k>
    <def cmt="musikterm">
      <gr>nn</gr>
      <dtrn>A</dtrn>
      <tr>a:</tr>
      <iref href="http://lexin.nada.kth.se/sound/a.mp3" />
      <def>sjätte tonen i C-durskalan</def>
    </def>
  </ar>
  <ar>
    <k>a conto</k>
    <def>
      <gr>ab</gr>
      <dtrn>on account</dtrn>
      <tr>ak'ån:to</tr>
      <iref href="http://lexin.nada.kth.se/sound/a conto.mp3" />
      <def>i förskott</def>
    </def>
  </ar>
  <ar>
    <k>à jour</k>
    <def cmt="franskt uttryck">
      <gr>jj</gr>
      <dtrn>abreast with</dtrn>
      <dtrn>up-to-date</dtrn>
      <dtrn>informed</dtrn>
      <tr>asj'o:r</tr>
      <iref href="http://lexin.nada.kth.se/sound/0340 jour.mp3" />
      <ex type="phr"><ex_orig>hålla sig (el. vara) à jour (med något) ("hålla sig informerad")</ex_orig><ex_transl>keep up to date (with sth.), keep abreast (of sth.) (&quot;keep oneself informed&quot;)</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>à la</k>
    <def cmt="ifråga om maträtter">
      <gr>ab</gr>
      <dtrn>à la</dtrn>
      <tr>ala</tr>
      <iref href="http://lexin.nada.kth.se/sound/0340 la.mp3" />
      <ex type="exm"><ex_orig>biff à la Lindström</ex_orig><ex_transl>beef patty à la Lindström</ex_transl>      </ex>
      <def>enligt</def>
    </def>
  </ar>
  <ar>
    <k>à la carte</k>
    <def cmt="franskt uttryck">
      <gr>ab</gr>
      <dtrn>à la carte</dtrn>
      <tr>alak'ar_t:</tr>
      <iref href="http://lexin.nada.kth.se/sound/0340 la carte.mp3" />
      <ex type="exm"><ex_orig>äta à la carte</ex_orig><ex_transl>eat (dine, lunch) à la carte</ex_transl>      </ex>
      <def>efter den fasta matsedeln</def>
    </def>
  </ar>
  <ar>
    <k>AB</k>
    <def cmt="i firmanamn">
      <gr>abbrev</gr>
      <dtrn>Ltd.</dtrn>
      <dtrn>Co.</dtrn>
      <dtrn>Inc.</dtrn>
      <tr>²'a:be:</tr>
      <iref href="http://lexin.nada.kth.se/sound/ab.mp3" />
      <ex type="exm"><ex_orig>Svenska Cellulosa AB</ex_orig><ex_transl>Swedish Cellulosa Ltd.</ex_transl>      </ex>
      <ex type="exm"><ex_orig>AB Svensk Bilprovning</ex_orig><ex_transl>The Swedish Motor Vehicle Inspection Co.</ex_transl>      </ex>
      <def>aktiebolag(et)</def>
    </def>
  </ar>
  <ar>
    <k>AB Svensk Bilprovning</k>
    <def>
      <gr>pn</gr>
      <dtrn>the Swedish Motor Vehicle Inspection Co.</dtrn>
      <tr>sven:sk ²b'i:lpro:vning</tr>
      <iref href="http://lexin.nada.kth.se/sound/ab svensk bilprovning.mp3" />
      <def>ett bolag som på sina stationer runt om i Sverige utför årliga obligatoriska kontrollbesiktningar av bilar</def>
    </def>
  </ar>
  <ar>
    <k>AB Svenska Spel</k>
    <def>
      <gr>pn</gr>
      <tr>²'a:be: sven:ska spe:l</tr>
      <iref href="http://lexin.nada.kth.se/sound/ab svenska spel.mp3" />
    </def>
  </ar>
  <ar>
    <k>abbé</k>
    <def>
      <gr>nn</gr>
      <dtrn>abbé</dtrn>
      <tr>ab'e:</tr>
      <iref href="http://lexin.nada.kth.se/sound/abb0351.mp3" />
      <def>titel för katolska präster som inte tillhör någon orden</def>
    </def>
  </ar>
  <ar>
    <k>abbedissa</k>
    <def>
      <gr>nn</gr>
      <dtrn>abbess</dtrn>
      <tr>²abed'is:a</tr>
      <iref href="http://lexin.nada.kth.se/sound/abbedissa.mp3" />
      <def>föreståndarinna för nunnekloster</def>
    </def>
  </ar>
  <ar>
    <k>abborre</k>
    <def>
      <gr>nn</gr>
      <dtrn>perch</dtrn>
      <tr>²'ab:år:e</tr>
      <iref href="http://lexin.nada.kth.se/sound/abborre.mp3" />
      <ex type="phr"><ex_orig>abborr|pinne</ex_orig><ex_transl>very small perch</ex_transl></ex>
      <def>(sötvattens) fisken Perca fluviatilis</def>
    </def>
  </ar>
  <ar>
    <k>abc</k>
    <def>
      <gr>nn</gr>
      <dtrn>abc</dtrn>
      <tr>a:be:s'e:</tr>
      <iref href="http://lexin.nada.kth.se/sound/abc.mp3" />
      <def>de första grunderna till ngt; alfabet</def>
    </def>
  </ar>
  <ar>
    <k>abc-bok</k>
    <def>
      <gr>nn</gr>
      <dtrn>spelling-book</dtrn>
      <dtrn>primer</dtrn>
      <tr>²'a:be:se:bo:k</tr>
      <iref href="http://lexin.nada.kth.se/sound/abc-bok.mp3" />
      <def>bok för läsinlärning</def>
    </def>
  </ar>
  <ar>
    <k>ABC-stridsmedel</k>
    <def>
      <gr>nn</gr>
      <dtrn>ABC weapons</dtrn>
      <tr>²a:be:s'e:stritsme:del</tr>
      <iref href="http://lexin.nada.kth.se/sound/ABC-stridsmedel.mp3" />
      <def>kärnvapen samt biologiska och kemiska vapen</def>
    </def>
  </ar>
  <ar>
    <k>abdikera</k>
    <def cmt="om kung e dyl">
      <gr>vb</gr>
      <dtrn>abdicate</dtrn>
      <tr>abdik'e:rar</tr>
      <iref href="http://lexin.nada.kth.se/sound/abdikerar.mp3" />
      <sr><kref type="syn">avgå</kref></sr>
      <sr><kref type="syn">avsäga sig tronen</kref></sr>
      <def>avgår</def>
    </def>
  </ar>
  <ar>
    <k>aber</k>
    <def>
      <gr>nn</gr>
      <dtrn>catch</dtrn>
      <dtrn>but</dtrn>
      <dtrn>snag</dtrn>
      <tr>'a:ber</tr>
      <iref href="http://lexin.nada.kth.se/sound/aber.mp3" />
      <ex type="exm"><ex_orig>ett litet aber</ex_orig><ex_transl>a slight snag</ex_transl>      </ex>
      <def>(oväntat) hinder</def>
    </def>
  </ar>
  <ar>
    <k>ABF</k>
    <def>
      <gr>abbrev</gr>
      <dtrn>ABF</dtrn>
      <tr>a:be:'ef:</tr>
      <iref href="http://lexin.nada.kth.se/sound/ABF.mp3" />
      <def>Arbetarnas Bildningsförbund</def>
    </def>
  </ar>
  <ar>
    <k>abnorm</k>
    <def>
      <gr>jj</gr>
      <dtrn>abnormal</dtrn>
      <tr>abn'år:m</tr>
      <iref href="http://lexin.nada.kth.se/sound/abnorm.mp3" />
      <sr><kref type="syn">missbildad</kref></sr>
      <sr><kref type="syn">onaturlig</kref></sr>
      <sr><kref type="syn">onormal</kref></sr>
      <def>inte naturlig, onormal</def>
    </def>
  </ar>
  <ar>
    <k>abonnemang</k>
    <def>
      <gr>nn</gr>
      <dtrn>subscription</dtrn>
      <tr>abånem'ang:</tr>
      <iref href="http://lexin.nada.kth.se/sound/abonnemang.mp3" />
      <ex type="phr"><ex_orig>årsabonnemang</ex_orig><ex_transl>annual subscription</ex_transl></ex>
      <ex type="phr"><ex_orig>abonnemangs|avgift</ex_orig><ex_transl>subscription (fee, price, rate)</ex_transl></ex>
      <def>beställning i förväg el. för längre tid (av tidning, teaterplats etc.)</def>
    </def>
  </ar>
  <ar>
    <k>abonnent</k>
    <def>
      <gr>nn</gr>
      <dtrn>subscriber</dtrn>
      <tr>abån'en:t</tr>
      <iref href="http://lexin.nada.kth.se/sound/abonnent.mp3" />
      <sr><kref type="syn">prenumerant</kref></sr>
      <ex type="phr"><ex_orig>elabonnent</ex_orig><ex_transl>power board (company) customer</ex_transl></ex>
      <ex type="phr"><ex_orig>abonnent|nummer</ex_orig><ex_transl>subscriber&amp;#39;s number</ex_transl></ex>
      <def>person som abonnerar på något; fast kund</def>
    </def>
  </ar>
  <ar>
    <k>abonnera</k>
    <def>
      <gr>vb</gr>
      <dtrn>subscribe</dtrn>
      <tr>abån'e:rar</tr>
      <iref href="http://lexin.nada.kth.se/sound/abonnerar.mp3" />
      <sr><kref type="syn">boka</kref></sr>
      <sr><kref type="syn">prenumerera</kref></sr>
      <ex type="exm"><ex_orig>abonnera på en tidning</ex_orig><ex_transl>subscribe to a newspaper</ex_transl>      </ex>
      <ex type="exm"><ex_orig>abonnerad buss</ex_orig><ex_transl>chartered (hired) bus</ex_transl>      </ex>
      <def>beställa och betala i förväg</def>
    </def>
  </ar>
  <ar>
    <k>abort</k>
    <def>
      <gr>nn</gr>
      <dtrn>abortion</dtrn>
      <tr>ab'år_t:</tr>
      <iref href="http://lexin.nada.kth.se/sound/abort.mp3" />
      <ex type="exm"><ex_orig>göra abort</ex_orig><ex_transl>have an abortion</ex_transl>      </ex>
      <ex type="exm"><ex_orig>få abort</ex_orig><ex_transl>have an abortion</ex_transl>      </ex>
      <ex type="exm"><ex_orig>illegal abort</ex_orig><ex_transl>illegal abortion</ex_transl>      </ex>
      <ex type="phr"><ex_orig>spontan abort (&quot;missfall&quot;)</ex_orig><ex_transl>spontaneous abortion (&amp;quot;miscarriage&amp;quot;)</ex_transl></ex>
      <def>(avsiktligt) avbrytande av havandeskap</def>
    </def>
  </ar>
