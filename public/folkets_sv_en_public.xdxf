    </def>
  </ar>
  <ar>
    <k>absorbera</k>
    <def>
      <gr>vb</gr>
      <dtrn>absorb</dtrn>
      <dtrn>soak (suck) up</dtrn>
      <tr>absårb'e:rar</tr>
      <iref href="http://lexin.nada.kth.se/sound/absorberar.mp3" />
      <sr><kref type="syn">uppta</kref></sr>
      <ex type="exm"><ex_orig>trasan absorberar vatten</ex_orig><ex_transl>the cloth absorbs (soaks up) water</ex_transl>      </ex>
      <def>suga upp</def>
    </def>
  </ar>
  <ar>
    <k>absorbera</k>
    <def>
      <gr>vb</gr>
      <dtrn>occupy</dtrn>
      <dtrn>absorb</dtrn>
      <dtrn>fill</dtrn>
      <tr>absårb'e:rar</tr>
      <iref href="http://lexin.nada.kth.se/sound/absorberar.mp3" />
      <ex type="exm"><ex_orig>arbetet absorberade honom fullständigt</ex_orig><ex_transl>the job absorbed him completely, he was engrossed in his work</ex_transl>      </ex>
      <def>helt uppta (någons) tankar</def>
    </def>
  </ar>
  <ar>
    <k>abstinens</k>
    <def>
      <gr>nn</gr>
      <dtrn>abstinence</dtrn>
      <tr>abstin'en:s</tr>
      <iref href="http://lexin.nada.kth.se/sound/abstinens.mp3" />
      <sr><kref type="syn">sug</kref></sr>
      <ex type="phr"><ex_orig>abstinens|besvär</ex_orig><ex_transl>withdrawal symptom</ex_transl></ex>
      <def>avhållsamhet (från alkohol, narkotika etc)</def>
    </def>
  </ar>
  <ar>
    <k>abstrahera</k>
    <def>
      <gr>vb</gr>
      <dtrn>abstract</dtrn>
      <tr>abstrah'e:rar</tr>
      <iref href="http://lexin.nada.kth.se/sound/abstraherar.mp3" />
      <def>skapa en abstrakt bild (av); tänka abstrakt</def>
    </def>
  </ar>
  <ar>
    <k>abstrakt</k>
    <def>
      <gr>jj</gr>
      <dtrn>abstract</dtrn>
      <tr>abstr'ak:t</tr>
      <iref href="http://lexin.nada.kth.se/sound/abstrakt.mp3" />
      <sr><kref type="syn">ogripbart</kref></sr>
      <ex type="phr"><ex_orig>abstrakt konst (&quot;konst som inte avbildar yttre ting&quot;)</ex_orig><ex_transl>abstract art (&amp;quot;non-figurative art&amp;quot;)</ex_transl></ex>
      <def>som bara kan upplevas genom tanken; inte verklig; svårfattlig</def>
    </def>
  </ar>
  <ar>
    <k>abstraktion</k>
    <def>
      <gr>nn</gr>
      <dtrn>abstraction</dtrn>
      <tr>abstraksj'o:n</tr>
      <iref href="http://lexin.nada.kth.se/sound/abstraktion.mp3" />
      <ex type="phr"><ex_orig>abstraktions|förmåga</ex_orig><ex_transl>power of abstraction</ex_transl></ex>
      <ex type="phr"><ex_orig>abstraktions|nivå</ex_orig><ex_transl>level of abstraction</ex_transl></ex>
      <def>det att abstrahera</def>
    </def>
  </ar>
  <ar>
    <k>abstraktion</k>
    <def>
      <gr>nn</gr>
      <dtrn>abstraction</dtrn>
      <tr>abstraksj'o:n</tr>
      <iref href="http://lexin.nada.kth.se/sound/abstraktion.mp3" />
      <def>ren tankeskapelse</def>
