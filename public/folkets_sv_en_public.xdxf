  <ar>
    <k>bevis</k>
    <def>
      <gr>nn</gr>
      <dtrn>testimony</dtrn>
      <dtrn>certificate</dtrn>
      <dtrn>proof</dtrn>
      <dtrn>evidence</dtrn>
      <tr>bev'i:s</tr>
