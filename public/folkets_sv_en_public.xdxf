      <ex type="phr"><ex_orig>kanon|bra</ex_orig><ex_transl>marvellous</ex_transl></ex>
      <ex type="phr"><ex_orig>kanon|form</ex_orig><ex_transl>great [physical] shape</ex_transl></ex>
      <def>mycket, enormt</def>
    </def>
  </ar>
  <ar>
    <k>kanot</k>
    <def>
      <gr>nn</gr>
      <dtrn>canoe</dtrn>
      <tr>kan'o:t</tr>
      <iref href="http://lexin.nada.kth.se/sound/kanot.mp3" />
      <def>smal båt som man paddlar</def>
    </def>
  </ar>
  <ar>
    <k>kanske</k>
    <def>
      <gr>ab</gr>
      <dtrn>perhaps</dtrn>
      <dtrn>maybe</dtrn>
      <tr>²k'an:sje</tr>
      <iref href="http://lexin.nada.kth.se/sound/kanske.mp3" />
      <sr><kref type="syn">antagligen</kref></sr>
      <sr><kref type="syn">eventuellt</kref></sr>
      <sr><kref type="syn">ganska</kref></sr>
      <sr><kref type="syn">kan hända</kref></sr>
      <sr><kref type="syn">kanhända</kref></sr>
      <sr><kref type="syn">måhända</kref></sr>
      <sr><kref type="syn">möjligen</kref></sr>
      <sr><kref type="syn">möjligtvis</kref></sr>
      <sr><kref type="syn">nog</kref></sr>
      <sr><kref type="syn">troligen</kref></sr>
      <sr><kref type="syn">vem vet</kref></sr>
      <ex type="exm"><ex_orig>det spelar kanske ingen roll</ex_orig><ex_transl>maybe it doesn&#39;t matter</ex_transl>      </ex>
      <ex type="exm"><ex_orig>kanske det</ex_orig><ex_transl>maybe so</ex_transl>      </ex>
      <def>möjligen, eventuellt, kanhända</def>
    </def>
  </ar>
  <ar>
