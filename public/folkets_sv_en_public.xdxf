      <ex type="exm"><ex_orig>respektera vår önskan att vara ifred!</ex_orig><ex_transl>respect our wish to be left in peace!</ex_transl>      </ex>
      <def>visa respekt för, ta hänsyn till</def>
    </def>
  </ar>
  <ar>
    <k>respektive</k>
    <def>
      <gr>jj</gr>
      <dtrn>respective</dtrn>
      <tr>respekt'i:ve</tr>
      <iref href="http://lexin.nada.kth.se/sound/respektive.mp3" />
      <ex type="exm"><ex_orig>sätta sig på sina respektive platser</ex_orig><ex_transl>sit in their respective places</ex_transl>      </ex>
      <def>var och en särskilt</def>
    </def>
  </ar>
