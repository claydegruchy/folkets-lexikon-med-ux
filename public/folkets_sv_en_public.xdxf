      <sr><kref type="syn">vansköta</kref></sr>
      <sr><kref type="syn">vanskötsel</kref></sr>
      <ex type="exm"><ex_orig>han misskötte sitt arbete</ex_orig><ex_transl>he neglected his job</ex_transl>      </ex>
      <def>sköta dåligt</def>
    </def>
  </ar>
  <ar>
    <k>missleda</k>
