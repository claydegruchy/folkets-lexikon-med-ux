      <gr>nn</gr>
      <dtrn>dismissal</dtrn>
      <tr>²r'e:spas:</tr>
      <iref href="http://lexin.nada.kth.se/sound/respass.mp3" />
      <ex type="phr"><ex_orig>få respass (&quot;bli ivägskickad el. avskedad&quot;)</ex_orig><ex_transl>get the sack (&amp;quot;be sent away or dismissed&amp;quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>ge någon respass (&quot;skicka iväg el. avskeda någon&quot;)</ex_orig><ex_transl>give a person the sack (&amp;quot;send sby off&amp;quot;)</ex_transl></ex>
    </def>
  </ar>
