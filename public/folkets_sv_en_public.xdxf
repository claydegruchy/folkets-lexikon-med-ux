      <ex type="exm"><ex_orig>tycka mycket om musik</ex_orig><ex_transl>enjoy music very much</ex_transl>      </ex>
      <ex type="exm"><ex_orig>mycket ofta</ex_orig><ex_transl>very often</ex_transl>      </ex>
      <ex type="exm"><ex_orig>försöket slog mycket väl ut</ex_orig><ex_transl>the attempt turned out very well</ex_transl>      </ex>
