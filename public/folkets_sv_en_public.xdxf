      <sr><kref type="syn">sarg</kref></sr>
      <ex type="exm"><ex_orig>skarpa kanter</ex_orig><ex_transl>sharp edges</ex_transl>      </ex>
      <ex type="exm"><ex_orig>skriva i kanten av en text</ex_orig><ex_transl>write in the margin of a text</ex_transl>      </ex>
      <ex type="phr"><ex_orig>ostkant</ex_orig><ex_transl>cheese rind</ex_transl></ex>
      <ex type="phr"><ex_orig>strandkant</ex_orig><ex_transl>beach; waterside</ex_transl></ex>
      <ex type="phr"><ex_orig>hålla sig på sin kant ("vara reserverad")</ex_orig><ex_transl>keep to oneself (&quot;be reserved&quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>på alla håll och kanter ("överallt")</ex_orig><ex_transl>all over the place (&quot;everywhere&quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>komma på kant ("bli ovän") med någon</ex_orig><ex_transl>fall out (&quot;become unfriendly&quot;) with sby</ex_transl></ex>
      <def>yttre del eller sida av något</def>
    </def>
  </ar>
