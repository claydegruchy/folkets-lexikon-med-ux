  <ar>
    <k>bidrag</k>
    <def>
      <gr>nn</gr>
      <dtrn>allowance</dtrn>
      <dtrn>benefit</dtrn>
      <dtrn>contribution</dtrn>
      <dtrn>subsidy</dtrn>
      <tr>²b'i:dra:g</tr>
      <iref href="http://lexin.nada.kth.se/sound/bidrag.mp3" />
      <sr><kref type="syn">donation</kref></sr>
      <sr><kref type="syn">gåva</kref></sr>
      <sr><kref type="syn">subvention</kref></sr>
      <sr><kref type="syn">tillskott</kref></sr>
      <sr><kref type="syn">underhåll</kref></sr>
      <sr><kref type="syn">understöd</kref></sr>
      <ex type="exm"><ex_orig>bidrag för energisparande åtgärder</ex_orig><ex_transl>contributions for measures taken to help save energy</ex_transl>      </ex>
      <ex type="exm"><ex_orig>statliga bidrag till sysselsättningen</ex_orig><ex_transl>government subsidies to help stimulate employment</ex_transl>      </ex>
      <ex type="exm"><ex_orig>föreningen är beroende av bidrag från allmänheten</ex_orig><ex_transl>the association is dependent on contributions from the general public</ex_transl>      </ex>
      <ex type="phr"><ex_orig>studiebidrag</ex_orig><ex_transl>student grant</ex_transl></ex>
      <def>hjälp, understöd av ekonomisk art; medverkan</def>
    </def>
  </ar>
  <ar>
    <k>bidra</k>
    <def>
      <gr>vb</gr>
      <dtrn>contribute</dtrn>
      <dtrn>make a contribution to</dtrn>
      <dtrn>help</dtrn>
      <dtrn>promote</dtrn>
      <tr>²b'i:dra:r</tr>
      <iref href="http://lexin.nada.kth.se/sound/bidrar.mp3" />
      <sr><kref type="syn">ge</kref></sr>
      <sr><kref type="syn">hjälpa</kref></sr>
      <sr><kref type="syn">tillföra</kref></sr>
      <ex type="exm"><ex_orig>en bidragande orsak till konflikten</ex_orig><ex_transl>one of the factors which contributed to the conflict</ex_transl>      </ex>
      <ex type="exm"><ex_orig>hon bidrog till en konstruktiv lösning av frågan</ex_orig><ex_transl>she helped bring the matter to a satisfactory conclusion</ex_transl>      </ex>
      <ex type="exm"><ex_orig>ett lotteri ska bidra till att finansiera verksamheten</ex_orig><ex_transl>a lottery will be organized to help finance the operation</ex_transl>      </ex>
      <def>hjälpa, medverka</def>
    </def>
  </ar>
  <ar>
    <k>biennal</k>
    <def>
      <gr>nn</gr>
