      <sr><kref type="syn">spillra</kref></sr>
      <sr><kref type="syn">åkt</kref></sr>
      <sr><kref type="syn">återstod</kref></sr>
      <sr><kref type="syn">återstående</kref></sr>
      <sr><kref type="syn">överbliven</kref></sr>
      <sr><kref type="syn">överskott</kref></sr>
