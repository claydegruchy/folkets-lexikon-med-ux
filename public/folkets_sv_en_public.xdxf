      <ex type="exm"><ex_orig>han bestämde det mesta</ex_orig><ex_transl>he was the one who made most of the decisions</ex_transl>      </ex>
      <ex type="exm"><ex_orig>hon bestämde över mig</ex_orig><ex_transl>she controlled my life</ex_transl>      </ex>
      <def>besluta, avgöra</def>
    </def>
