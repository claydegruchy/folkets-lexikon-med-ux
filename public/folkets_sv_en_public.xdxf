  <ar>
    <k>sak</k>
    <def cmt="även om moralisk fråga">
      <gr>nn</gr>
      <dtrn>question</dtrn>
      <dtrn>thing</dtrn>
      <dtrn>affair</dtrn>
      <dtrn>matter</dtrn>
