      <sr><kref type="syn">ogillande</kref></sr>
      <ex type="exm"><ex_orig>förslaget har väckt starkt missnöje bland lärarna</ex_orig><ex_transl>the proposal has sparked intense dissatisfaction among teachers</ex_transl>      </ex>
      <ex type="phr"><ex_orig>missnöjes|politik</ex_orig><ex_transl>politics of discontent</ex_transl></ex>
      <def>känsla av att något kunde fungera bättre</def>
    </def>
  </ar>
  <ar>
    <k>missriktad</k>
    <def cmt="oftast abstrakt">
      <gr>jj</gr>
      <dtrn>misdirected</dtrn>
      <tr>²m'is:rik:tad</tr>
      <iref href="http://lexin.nada.kth.se/sound/missriktad.mp3" />
      <ex type="exm"><ex_orig>hon undvek ämnet av missriktad omtanke om mig</ex_orig><ex_transl>she avoided the topic out of misdirected concern for me</ex_transl>      </ex>
      <def>riktad åt fel håll; felriktad</def>
    </def>
  </ar>
  <ar>
    <k>missräkna sig</k>
    <def>
      <gr>vb</gr>
      <dtrn>misjudge</dtrn>
