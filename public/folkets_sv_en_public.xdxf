      <gr>pp</gr>
      <dtrn>on</dtrn>
      <tr>på:</tr>
      <iref href="http://lexin.nada.kth.se/sound/p0345.mp3" />
      <ex type="exm"><ex_orig>på Gotland</ex_orig><ex_transl>on (the island of) Gotland</ex_transl>      </ex>
      <ex type="exm"><ex_orig>boken ligger på bordet</ex_orig><ex_transl>the book is on the table</ex_transl>      </ex>
      <ex type="exm"><ex_orig>på landet</ex_orig><ex_transl>in the country</ex_transl>      </ex>
      <ex type="phr"><ex_orig>vara på det klara med ("förstå, inse")</ex_orig><ex_transl>be clear (about sth.) (&quot;understand, grasp&quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>på det hela taget ("i stort sett")</ex_orig><ex_transl>all in all</ex_transl></ex>
      <ex type="phr"><ex_orig>på andra håll ("på andra platser")</ex_orig><ex_transl>elsewhere (&quot;in other places&quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>på grund av ("med stöd av, beroende på")</ex_orig><ex_transl>because of, on account of</ex_transl></ex>
      <def>i anslutning till, ovanpå</def>
    </def>
  </ar>
