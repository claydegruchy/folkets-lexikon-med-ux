      <sr><kref type="syn">mixtur</kref></sr>
      <ex type="exm"><ex_orig>en blandning av humor och allvar</ex_orig><ex_transl>a blend of humour and solemnity</ex_transl>      </ex>
      <ex type="exm"><ex_orig>en blandning av lera och vatten</ex_orig><ex_transl>a mixture of clay and water</ex_transl>      </ex>
      <ex type="phr"><ex_orig>stilblandning</ex_orig><ex_transl>mixture of styles</ex_transl></ex>
      <ex type="phr"><ex_orig>foderblandning</ex_orig><ex_transl>feed mix</ex_transl></ex>
      <def>något hoprört, något sammansatt</def>
    </def>
  </ar>
  <ar>
    <k>blank</k>
