      <ex type="phr"><ex_orig>universitetskansler</ex_orig><ex_transl>chancellor (of a university)</ex_transl></ex>
      <def>titel för hög ämbetsman</def>
    </def>
  </ar>
  <ar>
    <k>kansli</k>
