      <ex type="phr"><ex_orig>sittstrejk</ex_orig><ex_transl>sit-down strike, sit-in</ex_transl></ex>
      <ex type="phr"><ex_orig>strejk|brytare</ex_orig><ex_transl>scab, blackleg, strikebreaker</ex_transl></ex>
      <def>vägran att arbeta för att få vissa krav uppfyllda, arbetsnedläggelse</def>
    </def>
  </ar>
  <ar>
    <k>strejka</k>
