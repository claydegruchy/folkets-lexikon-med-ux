      <ex type="phr"><ex_orig>hålla tyst om något ("inte avslöja något")</ex_orig><ex_transl>keep quiet about sth. (&quot;not reveal anything&quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>en tyst överenskommelse ("en underförstådd överenskommelse")</ex_orig><ex_transl>a tacit understanding (&quot;unspoken agreement&quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>håll tyst! ("var tyst")</ex_orig><ex_transl>keep quiet! (&quot;be quiet&quot;)</ex_transl></ex>
      <def>som inte ger ljud ifrån sig</def>
    </def>
  </ar>
