      <ex type="phr"><ex_orig>åka på en blåsning ("bli lurad")</ex_orig><ex_transl>be swindled (&quot;cheated&quot;)</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>blåst</k>
