      <dtrn>death</dtrn>
      <tr>dö:d</tr>
      <iref href="http://lexin.nada.kth.se/sound/d0366d.mp3" />
      <sr><kref type="syn">avliden</kref></sr>
      <sr><kref type="syn">bortgång</kref></sr>
      <sr><kref type="syn">ej levande</kref></sr>
      <sr><kref type="syn">hädanfärd</kref></sr>
