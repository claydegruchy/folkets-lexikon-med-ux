    <k>reson</k>
    <def cmt="i fraser">
      <gr>nn</gr>
      <dtrn>reason</dtrn>
      <tr>res'o:n</tr>
      <iref href="http://lexin.nada.kth.se/sound/reson.mp3" />
      <sr><kref type="syn">förnuft</kref></sr>
      <sr><kref type="syn">vett</kref></sr>
      <ex type="phr"><ex_orig>ta reson (&quot;lyssna till sakskäl&quot;)</ex_orig><ex_transl>be reasonable &amp;quot;listen to reason&amp;quot;</ex_transl></ex>
      <def>förnuft</def>
    </def>
  </ar>
  <ar>
    <k>resonabel</k>
    <def>
      <gr>jj</gr>
      <dtrn>reasonable</dtrn>
      <tr>reson'a:bel</tr>
      <iref href="http://lexin.nada.kth.se/sound/resonabel.mp3" />
      <sr><kref type="syn">förnuftig</kref></sr>
      <sr><kref type="syn">hygglig</kref></sr>
      <sr><kref type="syn">rimlig</kref></sr>
      <sr><kref type="syn">vettig</kref></sr>
      <def>mottaglig för skäl, vettig</def>
    </def>
  </ar>
  <ar>
    <k>resonans</k>
    <def cmt="bildligt 'gensvar, förståelse'">
      <gr>nn</gr>
      <dtrn>resonance</dtrn>
      <tr>reson'an:s (el. -'ang:s)</tr>
      <iref href="http://lexin.nada.kth.se/sound/resonans.mp3" />
      <ex type="phr"><ex_orig>resonansbotten</ex_orig><ex_transl>sounding board</ex_transl></ex>
      <def>genklang</def>
    </def>
  </ar>
  <ar>
    <k>resonemang</k>
    <def cmt="även om enskild person 'tankegång'">
      <gr>nn</gr>
      <dtrn>discussion</dtrn>
      <tr>resonem'ang:</tr>
      <iref href="http://lexin.nada.kth.se/sound/resonemang.mp3" />
      <sr><kref type="syn">tankegång</kref></sr>
      <ex type="exm"><ex_orig>föra ett besynnerligt resonemang</ex_orig><ex_transl>follow an extraordinary line of reasoning</ex_transl>      </ex>
      <def>diskussion</def>
    </def>
  </ar>
  <ar>
    <k>resonera</k>
