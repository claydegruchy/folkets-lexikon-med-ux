    <k>alltså</k>
    <def cmt="vid sammanfattning eller precisering av det som sagts">
      <gr>ab</gr>
      <dtrn>in other words</dtrn>
      <dtrn>accordingly</dtrn>
      <dtrn>consequently</dtrn>
      <dtrn>that is to say</dtrn>
      <dtrn>thus</dtrn>
      <dtrn>therefore</dtrn>
      <tr>'al:tså</tr>
      <iref href="http://lexin.nada.kth.se/sound/allts0345.mp3" />
      <sr><kref type="syn">nämligen</kref></sr>
      <sr><kref type="syn">således</kref></sr>
      <ex type="exm"><ex_orig>första året, alltså 1974, gick allting bra</ex_orig><ex_transl>during our first year, in 1974 that is to say, things went well enough</ex_transl>      </ex>
      <def>således, följaktligen</def>
    </def>
  </ar>
