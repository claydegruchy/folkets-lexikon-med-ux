      <ex type="exm"><ex_orig>det lovar gott för framtiden</ex_orig><ex_transl>it bids well for the future</ex_transl>      </ex>
      <ex type="phr"><ex_orig>det vill jag lova ("det kan jag försäkra")</ex_orig><ex_transl>that I promise (&quot;that I can assure (you)&quot;)</ex_transl></ex>
      <def>ge löfte om, försäkra</def>
    </def>
