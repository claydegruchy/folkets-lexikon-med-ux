      <iref href="http://lexin.nada.kth.se/sound/misslyckas.mp3" />
      <sr><kref type="syn">bakslag</kref></sr>
      <sr><kref type="syn">bomma</kref></sr>
      <sr><kref type="syn">göra fiasko</kref></sr>
      <sr><kref type="syn">haverera</kref></sr>
