      <ex type="exm"><ex_orig>saken berodde på ett missförstånd</ex_orig><ex_transl>the matter was the result of a misunderstanding</ex_transl>      </ex>
      <def>feluppfattning (av misstag)</def>
    </def>
  </ar>
  <ar>
    <k>missförstå</k>
