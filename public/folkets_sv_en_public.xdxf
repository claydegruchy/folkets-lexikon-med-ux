      <sr><kref type="syn">frustrerad</kref></sr>
      <sr><kref type="syn">missbelåten</kref></sr>
      <sr><kref type="syn">misslynt</kref></sr>
      <sr><kref type="syn">otillfreds</kref></sr>
      <sr><kref type="syn">otillfredsställd</kref></sr>
      <sr><kref type="syn">sur</kref></sr>
