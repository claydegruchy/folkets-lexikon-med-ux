      <dtrn>meticulous</dtrn>
      <tr>minutsi'ö:s</tr>
      <iref href="http://lexin.nada.kth.se/sound/minuti0366s.mp3" />
      <def>mycket noggrann</def>
    </def>
  </ar>
  <ar>
    <k>mirakel</k>
