    <def>
      <gr>nn</gr>
      <dtrn>answer</dtrn>
      <dtrn>information</dtrn>
      <tr>besj'e:d</tr>
      <iref href="http://lexin.nada.kth.se/sound/besked.mp3" />
      <sr><kref type="syn">meddelande</kref></sr>
      <sr><kref type="syn">svar</kref></sr>
      <ex type="exm"><ex_orig>exakta besked gick inte att få</ex_orig><ex_transl>it was impossible to obtain any exact information</ex_transl>      </ex>
      <ex type="exm"><ex_orig>i söndags fick de besked att de måste flytta</ex_orig><ex_transl>last Sunday they were informed that they would have to move</ex_transl>      </ex>
      <ex type="exm"><ex_orig>vi väntar på besked från landstinget</ex_orig><ex_transl>we are waiting for an answer from the county council</ex_transl>      </ex>
      <def>svar, upplysning</def>
    </def>
  </ar>
  <ar>
    <k>besked</k>
    <def cmt="i frasen 'med besked' '(=med eftertryck, kraftfullt)'">
      <gr>nn</gr>
      <dtrn>properly, really</dtrn>
      <tr>besj'e:d</tr>
