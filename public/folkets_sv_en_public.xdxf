      <gr>abbrev</gr>
      <dtrn>respective</dtrn>
      <tr>respekt'i:ve</tr>
      <iref href="http://lexin.nada.kth.se/sound/resp.mp3" />
      <def>respektive</def>
    </def>
  </ar>
  <ar>
    <k>respass</k>
