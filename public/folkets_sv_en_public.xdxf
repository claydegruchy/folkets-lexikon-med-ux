      <def>hög värdering av person, aktning</def>
    </def>
  </ar>
  <ar>
    <k>respektabel</k>
    <def>
      <gr>jj</gr>
      <dtrn>respectable</dtrn>
      <tr>respekt'a:bel</tr>
      <iref href="http://lexin.nada.kth.se/sound/respektabel.mp3" />
      <sr><kref type="syn">anständig</kref></sr>
      <ex type="exm"><ex_orig>en respektabel krog</ex_orig><ex_transl>a respectable restaurant</ex_transl>      </ex>
      <def>som förtjänar respekt, anständig</def>
    </def>
  </ar>
  <ar>
    <k>respektera</k>
    <def>
      <gr>vb</gr>
      <dtrn>respect</dtrn>
      <tr>respekt'e:rar</tr>
      <iref href="http://lexin.nada.kth.se/sound/respekterar.mp3" />
      <sr><kref type="syn">akta</kref></sr>
      <sr><kref type="syn">högakta</kref></sr>
      <sr><kref type="syn">ta hänsyn</kref></sr>
      <sr><kref type="syn">vörda</kref></sr>
