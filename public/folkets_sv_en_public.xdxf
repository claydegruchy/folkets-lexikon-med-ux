      <dtrn>in</dtrn>
      <dtrn>during</dtrn>
      <tr>på:</tr>
      <iref href="http://lexin.nada.kth.se/sound/p0345.mp3" />
      <ex type="exm"><ex_orig>på natten</ex_orig><ex_transl>at (in the) night</ex_transl>      </ex>
      <ex type="exm"><ex_orig>på torsdag</ex_orig><ex_transl>on Thursday</ex_transl>      </ex>
      <ex type="exm"><ex_orig>på hösten</ex_orig><ex_transl>in the autumn</ex_transl>      </ex>
      <ex type="exm"><ex_orig>jag åt inte på en vecka</ex_orig><ex_transl>I didn&#39;t eat for a week</ex_transl>      </ex>
      <ex type="phr"><ex_orig>vara på väg ("hålla på") att försvinna</ex_orig><ex_transl>be on the way to (in the process of) disappearing, dying out</ex_transl></ex>
      <ex type="phr"><ex_orig>på lång sikt ("med resultat någon gång i framtiden")</ex_orig><ex_transl>in the long term (&quot;with a result some time in the future&quot;)</ex_transl></ex>
      <ex type="phr"><ex_orig>vara på gång ("hålla på att hända")</ex_orig><ex_transl>be in the process of happening</ex_transl></ex>
      <ex type="phr"><ex_orig>på sistone ("under senare tid")</ex_orig><ex_transl>recently</ex_transl></ex>
      <ex type="phr"><ex_orig>på nytt ("om igen")</ex_orig><ex_transl>again</ex_transl></ex>
      <ex type="phr"><ex_orig>på besök ("som gäst")</ex_orig><ex_transl>visiting (&quot;as a guest&quot;)</ex_transl></ex>
      <def>under, inom</def>
    </def>
  </ar>
