      <ex type="exm"><ex_orig>släppa loss fångar</ex_orig><ex_transl>release prisoners</ex_transl>      </ex>
      <ex type="phr"><ex_orig>komma loss (&quot;släppa på hämningarna&quot;)</ex_orig><ex_transl>let go (&amp;quot;release inhibitions&amp;quot;)</ex_transl></ex>
