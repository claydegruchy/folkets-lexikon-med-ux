      <sr><kref type="syn">pryl</kref></sr>
      <sr><kref type="syn">ting</kref></sr>
      <ex type="exm"><ex_orig>sak samma</ex_orig><ex_transl>that makes no difference</ex_transl>      </ex>
      <ex type="exm"><ex_orig>gå rakt på sak</ex_orig><ex_transl>not beat about the bush</ex_transl>      </ex>
      <ex type="exm"><ex_orig>det är en annan sak</ex_orig><ex_transl>that&#39;s another thing</ex_transl>      </ex>
      <ex type="exm"><ex_orig>det är regeringens sak att avgöra den frågan</ex_orig><ex_transl>that&#39;s sth. the government will have to settle</ex_transl>      </ex>
      <ex type="exm"><ex_orig>till saken!</ex_orig><ex_transl>get to the point!</ex_transl>      </ex>
      <ex type="phr"><ex_orig>huvudsak</ex_orig><ex_transl>main thing</ex_transl></ex>
      <ex type="phr"><ex_orig>hederssak</ex_orig><ex_transl>point of honour</ex_transl></ex>
      <ex type="phr"><ex_orig>kvinnosak</ex_orig><ex_transl>women&#39;s rights issue</ex_transl></ex>
      <def>angelägenhet (som bör åtgärdas)</def>
    </def>
