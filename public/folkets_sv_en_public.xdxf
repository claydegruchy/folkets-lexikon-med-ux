      <iref href="http://lexin.nada.kth.se/sound/d0344ri.mp3" />
      <ex type="exm"><ex_orig>däri har du rätt</ex_orig><ex_transl>you are right in that respect</ex_transl>      </ex>
      <def>i/på samma plats</def>
    </def>
  </ar>
  <ar>
    <k>därifrån</k>
