      <sr><kref type="syn">förvilla</kref></sr>
      <sr><kref type="syn">vilseföra</kref></sr>
      <sr><kref type="syn">vilseleda</kref></sr>
      <def>vilseleda</def>
    </def>
  </ar>
  <ar>
    <k>misslyckad</k>
