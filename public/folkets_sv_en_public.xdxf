      <sr><kref type="syn">upprätthålla</kref></sr>
      <sr><kref type="syn">vidmakthålla</kref></sr>
      <sr><kref type="syn">vårda</kref></sr>
      <ex type="exm"><ex_orig>bevara det gamla</ex_orig><ex_transl>conserve the old</ex_transl>      </ex>
      <ex type="exm"><ex_orig>bevara sysselsättningen</ex_orig><ex_transl>keep employment up</ex_transl>      </ex>
      <def>ha kvar, spara, behålla; skydda</def>
    </def>
  </ar>
