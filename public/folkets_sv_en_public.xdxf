      <sr><kref type="syn">meddelande</kref></sr>
      <sr><kref type="syn">svar</kref></sr>
      <ex type="exm"><ex_orig>när hon svarade gjorde hon det med besked</ex_orig><ex_transl>when she did answer, she did so with a vengeance</ex_transl>      </ex>
    </def>
  </ar>
