      <gr>nn</gr>
      <dtrn>result</dtrn>
      <tr>result'a:t</tr>
      <iref href="http://lexin.nada.kth.se/sound/resultat.mp3" />
      <sr><kref type="syn">konklusion</kref></sr>
      <sr><kref type="syn">utfall</kref></sr>
      <sr><kref type="syn">utslag</kref></sr>
