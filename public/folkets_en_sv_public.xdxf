      <dtrn>erhålla</dtrn>
      <dtrn>få</dtrn>
      <ex type="exm"><ex_orig>how much do you make annually?</ex_orig><ex_transl>hur mycket tjänar du om året?</ex_transl>      </ex>
      <ex type="exm"><ex_orig>I&amp;#39;ve made a new friend</ex_orig><ex_transl>jag har fått en ny vän</ex_transl>      </ex>
      <ex type="phr"><ex_orig>make a living</ex_orig><ex_transl>tjäna sitt uppehälle</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>make</k>
    <def>
      <gr>vb</gr>
