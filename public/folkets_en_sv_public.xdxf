      <ex type="phr"><ex_orig>get the message</ex_orig><ex_transl>förstå</ex_transl></ex>
      <ex type="phr"><ex_orig>got it?</ex_orig><ex_transl>hajar du?</ex_transl></ex>
    </def>
  </ar>
  <ar>
