      <ex type="phr"><ex_orig>give the game away</ex_orig><ex_transl>avslöja alltihop</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>give away</k>
    <def>
      <gr>vb</gr>
      <dtrn>dela ut</dtrn>
      <ex type="exm"><ex_orig>the principal gave away the scholarships on graduation day</ex_orig><ex_transl>rektorn delade ut stipendierna på examensdagen</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give away</k>
    <def>
      <gr>vb</gr>
      <dtrn>förråda</dtrn>
      <ex type="exm"><ex_orig>he tried to appear cool, but his nervous eyes gave him away</ex_orig><ex_transl>han försökte verka lugn, men hans nervösa ögon förrådde honom</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give away</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge bort</dtrn>
      <dtrn>förlora</dtrn>
      <dtrn>sumpa</dtrn>
      <ex type="exm"><ex_orig>don&amp;#39;t give away your chance of getting a good mark on the exam</ex_orig><ex_transl>sumpa inte dina möjligheter att få ett bra betyg på tentan</ex_transl>      </ex>
      <ex type="exm"><ex_orig>she gave away all her old dresses</ex_orig><ex_transl>hon gav bort alla sina gamla klänningar</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give away</k>
    <def>
      <gr>vb</gr>
      <dtrn>överlämna</dtrn>
      <ex type="exm"><ex_orig>who gives the bride away?</ex_orig><ex_transl>vem överlämnar bruden till brudgummen?</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give back</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge igen</dtrn>
      <dtrn>återlämna</dtrn>
      <ex type="exm"><ex_orig>I want you to give me back my book now</ex_orig><ex_transl>jag vill att du lämnar tillbaka boken till mig nu</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give in</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge efter</dtrn>
      <ex type="exm"><ex_orig>we mustn&amp;#39;t give in to his demands</ex_orig><ex_transl>vi får inte ge efter för hans krav</ex_transl>      </ex>
      <ex type="phr"><ex_orig>give in to one&#39;s temptations</ex_orig><ex_transl>ge efter för sina frestelser</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>give in</k>
    <def>
      <gr>vb</gr>
      <dtrn>lämna in</dtrn>
      <ex type="exm"><ex_orig>you must give in your exam by two o&amp;#39;clock</ex_orig><ex_transl>du måste lämna in tentan senast klockan två</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give of</k>
    <def cmt="formellt">
      <gr>vb</gr>
      <dtrn>ge av någonting</dtrn>
      <ex type="exm"><ex_orig>my mother has given very generously of her time</ex_orig><ex_transl>min mor har varit mycket generös med sin tid</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give off</k>
    <def>
      <gr>vb</gr>
      <dtrn>avge</dtrn>
      <dtrn>avsöndra</dtrn>
      <ex type="exm"><ex_orig>that cheese is giving off an awful smell</ex_orig><ex_transl>den där osten avger en förfärlig lukt</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give oneself over to</k>
    <def>
      <gr>vb</gr>
      <dtrn>hän|ge sig åt</dtrn>
      <dtrn>helt ägna sig åt</dtrn>
      <dtrn>helt gå upp i</dtrn>
      <ex type="exm"><ex_orig>he has given himself completely over to work lately</ex_orig><ex_transl>han har helt gått upp i sitt arbete på sista tiden</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give onto</k>
    <def>
      <gr>vb</gr>
      <dtrn>vetta mot</dtrn>
      <ex type="exm"><ex_orig>the back door gives onto the sea</ex_orig><ex_transl>bakdörren vetter mot havet</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give out</k>
    <def>
      <gr>vb</gr>
      <dtrn>dela ut</dtrn>
      <dtrn>distribuera</dtrn>
      <ex type="exm"><ex_orig>you may give out the exams now</ex_orig><ex_transl>du kan dela ut skrivningarna nu</ex_transl>      </ex>
      <ex type="phr"><ex_orig>give out food</ex_orig><ex_transl>dela ut mat</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>give out</k>
    <def>
      <gr>vb</gr>
      <dtrn>sluta fungera</dtrn>
      <dtrn>gå sönder</dtrn>
      <ex type="exm"><ex_orig>the engine has completely given out</ex_orig><ex_transl>motorn har gått sönder helt</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give out</k>
    <def>
      <gr>vb</gr>
      <dtrn>sända ut</dtrn>
      <dtrn>avge</dtrn>
      <ex type="exm"><ex_orig>the dog gave out a yell</ex_orig><ex_transl>hunden avgav ett skrik</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give out</k>
    <def>
      <gr>vb</gr>
      <dtrn>tillkännage</dtrn>
      <dtrn>meddela</dtrn>
      <ex type="exm"><ex_orig>it was given out on the news that the princess had died</ex_orig><ex_transl>det tillkännagavs på nyheterna att prinsessan hade dött</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give out</k>
    <def>
      <gr>vb</gr>
      <dtrn>upphöra</dtrn>
      <dtrn>ta slut</dtrn>
      <ex type="exm"><ex_orig>her strength gave out</ex_orig><ex_transl>hennes krafter tog slut</ex_transl>      </ex>
      <ex type="exm"><ex_orig>it seems our supply of flour has given out</ex_orig><ex_transl>det verkar som vårt mjölförråd har tagit slut</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give over to</k>
    <def>
      <gr>vb</gr>
      <dtrn>överlämna</dtrn>
      <dtrn>överlåta</dtrn>
      <ex type="exm"><ex_orig>this room has been given over to aerobics in the afternoons</ex_orig><ex_transl>i det här rummet pågår aerobics på eftermiddagarna</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give over</k>
    <def>
      <gr>vb</gr>
      <dtrn>sluta</dtrn>
      <ex type="exm"><ex_orig>if you don&amp;#39;t give over soon, I&amp;#39;ll start to scream</ex_orig><ex_transl>om du inte slutar snart börjar jag skrika</ex_transl>      </ex>
      <ex type="phr"><ex_orig>do give over!</ex_orig><ex_transl>var snäll och sluta!</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>give over</k>
    <def>
      <gr>vb</gr>
      <dtrn>sluta</dtrn>
      <ex type="exm"><ex_orig>please give over whistling</ex_orig><ex_transl>var snäll och sluta vissla</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give up on</k>
    <def cmt="informellt">
      <gr>vb</gr>
      <dtrn>ge upp hoppet om</dtrn>
      <ex type="exm"><ex_orig>I have completely given up on him</ex_orig><ex_transl>jag har helt gett upp hoppet om honom</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give up to</k>
    <def>
      <gr>vb</gr>
      <dtrn>hänge sig åt</dtrn>
      <ex type="exm"><ex_orig>he has given himself up to his grief</ex_orig><ex_transl>han har gett sig hän åt sin sorg</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give up</k>
    <def>
      <gr>vb</gr>
      <dtrn>ange</dtrn>
      <dtrn>överlämna</dtrn>
      <ex type="exm"><ex_orig>I have decided to give myself up</ex_orig><ex_transl>jag har bestämt mig för att överlämna mig själv till polisen</ex_transl>      </ex>
      <ex type="exm"><ex_orig>she gave her boyfriend up to the police</ex_orig><ex_transl>hon överlämnade sin pojkvän till polisen</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give up</k>
    <def>
      <gr>vb</gr>
      <dtrn>avstå från</dtrn>
      <ex type="exm"><ex_orig>he was nice enough to give up his seat to me</ex_orig><ex_transl>han var vänlig nog att avstå sin plats åt mig</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give up</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge upp hoppet</dtrn>
      <ex type="exm"><ex_orig>we had given him up when he came back to life</ex_orig><ex_transl>vi hade gett upp hoppet om honom när han återvände till livet</ex_transl>      </ex>
      <ex type="phr"><ex_orig>be given up for dead</ex_orig><ex_transl>betraktas som död (när man har givit upp hoppet om att finna vederbörande vid liv)</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>give up</k>
    <def>
      <gr>vb</gr>
      <dtrn>sluta försöka</dtrn>
      <dtrn>ge upp</dtrn>
      <dtrn>ge tappt</dtrn>
      <ex type="exm"><ex_orig>I give up; tell me who it is</ex_orig><ex_transl>jag ger up; berätta för mig vem det är</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give up</k>
    <def>
      <gr>vb</gr>
      <dtrn>sluta umgås med</dtrn>
      <ex type="exm"><ex_orig>he gave up most of his friends from school when he started his new job</ex_orig><ex_transl>han slutade umgås med de flesta av sina skolkamrater när han började på sitt nya arbete</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give up</k>
    <def>
      <gr>vb</gr>
      <dtrn>sluta</dtrn>
      <ex type="exm"><ex_orig>I don&amp;#39;t drink anymore; I gave up two years ago</ex_orig><ex_transl>jag dricker inte längre; jag slutade för två år sedan</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give up</k>
    <def>
      <gr>vb</gr>
      <dtrn>sluta</dtrn>
      <ex type="exm"><ex_orig>I&amp;#39;ve finally given up smoking</ex_orig><ex_transl>jag har äntligen slutat röka</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give way</k>
    <def>
      <gr>vb</gr>
      <dtrn>ersätta</dtrn>
      <ex type="exm"><ex_orig>old habits are giving way to new ones</ex_orig><ex_transl>nya vanor håller på att ersätta gamla</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give way</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge efter</dtrn>
      <dtrn>gå med på</dtrn>
      <ex type="exm"><ex_orig>my father has finally given way to my wishes</ex_orig><ex_transl>min far har äntligen gått med på mina önskemål</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give way</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge vika</dtrn>
      <dtrn>svikta</dtrn>
      <dtrn>gå sönder</dtrn>
      <dtrn>brista</dtrn>
      <ex type="exm"><ex_orig>the floors will soon give way</ex_orig><ex_transl>golven kommer snart att brista</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give way</k>
    <def>
      <gr>vb</gr>
      <dtrn>hem|falla</dtrn>
      <dtrn>ge efter</dtrn>
      <ex type="exm"><ex_orig>she finally gave way to her grief</ex_orig><ex_transl>till slut gav hon efter för sin sorg</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give way</k>
    <def>
      <gr>vb</gr>
      <dtrn>lämna företräde</dtrn>
      <ex type="exm"><ex_orig>you are supposed to give way to traffic coming from the right</ex_orig><ex_transl>du ska lämna företräde åt bilar som kommer från höger</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def cmt="formellt">
      <gr>vb</gr>
      <dtrn>få att tro</dtrn>
      <ex type="exm"><ex_orig>he gave me to understand that breakfast would be served</ex_orig><ex_transl>han fick mig att tro att det skulle serveras frukost</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge</dtrn>
      <ex type="exm"><ex_orig>they gave him five years</ex_orig><ex_transl>han fick fem års fängelse</ex_transl>      </ex>
      <ex type="exm"><ex_orig>my teacher gave me detention for being late five mornings in a row</ex_orig><ex_transl>min lärare gav mig kvarsittning för att jag hade kommit för sent fem morgnar i rad</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge med sig</dtrn>
      <dtrn>gå sönder</dtrn>
      <dtrn>bli ohållbar</dtrn>
      <ex type="exm"><ex_orig>there&amp;#39;s so much tension at work right now that something will give soon</ex_orig><ex_transl>det är så spänt på arbetet just nu att det snart kommer att bli alldeles ohållbart</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge med sig</dtrn>
      <dtrn>gå sönder</dtrn>
      <ex type="exm"><ex_orig>the bench is beginning to give</ex_orig><ex_transl>bänken börjar ge med sig (kommer snart att gå sönder)</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge som ursäkt eller förklaring</dtrn>
      <ex type="exm"><ex_orig>he gave me some nosense about missing the bus</ex_orig><ex_transl>han gav mig någon slags ursäkt om att ha missat någon buss</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge</dtrn>
      <ex type="exm"><ex_orig>he gave me a hug</ex_orig><ex_transl>han kramade mig</ex_transl>      </ex>
      <ex type="exm"><ex_orig>he gave my a hand a squeeze</ex_orig><ex_transl>han kramade min hand</ex_transl>      </ex>
      <ex type="exm"><ex_orig>we gave the car a good push</ex_orig><ex_transl>vi sköt på bilen</ex_transl>      </ex>
      <ex type="phr"><ex_orig>give somebody a kiss</ex_orig><ex_transl>pussa/kyssa någon</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge</dtrn>
      <ex type="exm"><ex_orig>the prime minister is giving a press conference this afternoon</ex_orig><ex_transl>premiärministern ska ha presskonferens i eftermiddag</ex_transl>      </ex>
      <ex type="phr"><ex_orig>give a concert</ex_orig><ex_transl>ge en konsert</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge</dtrn>
      <dtrn>skänka</dtrn>
      <dtrn>donera</dtrn>
      <ex type="exm"><ex_orig>people always give generously to the Red Cross</ex_orig><ex_transl>folk är alltid generösa med att skänka pengar till Röda korset</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge</dtrn>
      <dtrn>avsätta</dtrn>
      <dtrn>offra</dtrn>
      <ex type="exm"><ex_orig>he is ready to give his life for the party</ex_orig><ex_transl>han är beredd att offra livet för partiet</ex_transl>      </ex>
      <ex type="phr"><ex_orig>give something more attention</ex_orig><ex_transl>vara mer uppmärksam på någonting</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge</dtrn>
      <dtrn>betala</dtrn>
      <ex type="exm"><ex_orig>how much did you give for that old car?</ex_orig><ex_transl>vad gav du för den där gamla bilen?</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def cmt="informellt">
      <gr>vb</gr>
      <dtrn>ge</dtrn>
      <dtrn>erkänna</dtrn>
      <ex type="exm"><ex_orig>it wasn&amp;#39;t all that cold out today, I give you that</ex_orig><ex_transl>det var inte så farligt kallt ute i dag, det erkännes</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge</dtrn>
      <dtrn>frambringa</dtrn>
      <ex type="exm"><ex_orig>he gives the impression of being very well prepared</ex_orig><ex_transl>han gör ett mycket väl förberett intryck</ex_transl>      </ex>
      <ex type="phr"><ex_orig>give somebody a shock</ex_orig><ex_transl>ge någon en chock</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge</dtrn>
      <dtrn>låta få</dtrn>
      <ex type="exm"><ex_orig>could you give me a better example?</ex_orig><ex_transl>kan du ge mig ett bättre exempel?</ex_transl>      </ex>
      <ex type="exm"><ex_orig>do give her my regards</ex_orig><ex_transl>var snäll och hälsa till henne från mig</ex_transl>      </ex>
      <ex type="exm"><ex_orig>I never gave you permission to go out tonight</ex_orig><ex_transl>jag gav dig aldrig tillåtelse att gå ut i kväll</ex_transl>      </ex>
      <ex type="exm"><ex_orig>what gave you that idea?</ex_orig><ex_transl>vad fick dig att tro det?</ex_transl>      </ex>
      <ex type="phr"><ex_orig>give evidence</ex_orig><ex_transl>lämna vittnesmål, vittna</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge</dtrn>
      <dtrn>låta få</dtrn>
      <ex type="exm"><ex_orig>my doctor gave me a year at most</ex_orig><ex_transl>min läkare gav mig högst ett år till att leva</ex_transl>      </ex>
      <ex type="exm"><ex_orig>you&amp;#39;ve got to give me a couple of hours to dig up that document from the archives</ex_orig><ex_transl>du måste ge mig ett par timmar att gräva fram det där dokumentet i arkivet</ex_transl>      </ex>
      <ex type="phr"><ex_orig>given the chance, I would...</ex_orig><ex_transl>om jag fick chansen, skulle jag...</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge</dtrn>
      <dtrn>utföra</dtrn>
      <ex type="exm"><ex_orig>she gave a short, nervous laugh</ex_orig><ex_transl>hon skrattade till kort och nervöst</ex_transl>      </ex>
      <ex type="phr"><ex_orig>give a sigh</ex_orig><ex_transl>sucka</ex_transl></ex>
      <ex type="phr"><ex_orig>give a shrug</ex_orig><ex_transl>rycka på axlarna</ex_transl></ex>
      <ex type="phr"><ex_orig>give a smile</ex_orig><ex_transl>le</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge</dtrn>
      <dtrn>överlämna som gåva</dtrn>
      <dtrn>räcka</dtrn>
      <ex type="exm"><ex_orig>my mother gave me a new watch for my birthday</ex_orig><ex_transl>min mor gav mig en ny (armbands)klocka i födelsedagspresent</ex_transl>      </ex>
      <ex type="phr"><ex_orig>give as good as one gets</ex_orig><ex_transl>betala med samma mynt</ex_transl></ex>
      <ex type="phr"><ex_orig>give it to me straight</ex_orig><ex_transl>säg precis som det är (informellt)</ex_transl></ex>
      <ex type="phr"><ex_orig>give me...</ex_orig><ex_transl>jag föredrar.../tacka vet jag...</ex_transl></ex>
      <ex type="phr"><ex_orig>give or take</ex_orig><ex_transl>på ett ungefär</ex_transl></ex>
      <ex type="phr"><ex_orig>not give a damn</ex_orig><ex_transl>inte bry sig ett dugg om... (informellt)</ex_transl></ex>
      <ex type="phr"><ex_orig>give anything/the world to...</ex_orig><ex_transl>göra vad som helst för...</ex_transl></ex>
      <ex type="phr"><ex_orig>give one&#39;s right arm to...</ex_orig><ex_transl>hugga av sig ena handen för...</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>give</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge</dtrn>
