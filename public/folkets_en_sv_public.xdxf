      <ex type="phr"><ex_orig>blow somebody&#39;s mind</ex_orig><ex_transl>överväldigas (slanguttryck)</ex_transl></ex>
      <ex type="phr"><ex_orig>have half a mind to</ex_orig><ex_transl>ha god lust att</ex_transl></ex>
      <ex type="phr"><ex_orig>have in mind</ex_orig><ex_transl>ha för avsikt</ex_transl></ex>
      <ex type="phr"><ex_orig>make up one&#39;s mind</ex_orig><ex_transl>bestämma sig</ex_transl></ex>
      <ex type="phr"><ex_orig>set one&#39;s mind on (doing something)</ex_orig><ex_transl>bestämma sig för/vara fast besluten (att göra någonting)</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>mind</k>
    <def>
      <gr>nn</gr>
      <dtrn>förstånd</dtrn>
      <dtrn>intellekt</dtrn>
      <dtrn>hjärna</dtrn>
      <ex type="exm"><ex_orig>my mind tells me to do one thing and my heart another</ex_orig><ex_transl>förståndet säger åt mig att göra en sak och hjärtat något annat</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>mind</k>
    <def>
      <gr>vb</gr>
      <dtrn>ha något emot</dtrn>
      <dtrn>vara besvärad av</dtrn>
      <ex type="exm"><ex_orig>I wouldn&amp;#39;t mind a cup of coffee</ex_orig><ex_transl>jag skulle gärna dricka en kopp kaffe</ex_transl>      </ex>
      <ex type="exm"><ex_orig>do you the mind the window (being) open?</ex_orig><ex_transl>har du något emot att fönstret är öppet?</ex_transl>      </ex>
      <ex type="phr"><ex_orig>mind one&#39;s own business</ex_orig><ex_transl>(vanligen i imperativ) sköta sina egna affärer (och inte lägga sig i andras)</ex_transl></ex>
      <ex type="phr"><ex_orig>mind one&#39;s p&#39;s and q&#39;s</ex_orig><ex_transl>hålla tungan rätt i mun (informellt)</ex_transl></ex>
      <ex type="phr"><ex_orig>mind you</ex_orig><ex_transl>märk väl, notera dock (även endast mind)</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>mind</k>
    <def>
      <gr>vb</gr>
      <dtrn>ha något emot</dtrn>
      <dtrn>vara besvärad</dtrn>
      <ex type="exm"><ex_orig>do you mind if I smoke?</ex_orig><ex_transl>har du/ni något emot att jag röker?</ex_transl>      </ex>
      <ex type="exm"><ex_orig>would you mind opening the window?</ex_orig><ex_transl>skulle du/ni ha något emot att öppna fönstret?</ex_transl>      </ex>
      <ex type="phr"><ex_orig>do you mind?</ex_orig><ex_transl>ursäkta! (uttrycker irritation)</ex_transl></ex>
      <ex type="phr"><ex_orig>I don&#39;t mind</ex_orig><ex_transl>inte mig emot; det spelar ingen roll vilken</ex_transl></ex>
      <ex type="phr"><ex_orig>I don&#39;t mind if I do</ex_orig><ex_transl>ja tack, gärna</ex_transl></ex>
      <ex type="phr"><ex_orig>mind</ex_orig><ex_transl>märk väl, notera dock (även mind you)</ex_transl></ex>
      <ex type="phr"><ex_orig>never mind</ex_orig><ex_transl>det är ingen fara, bekymra dig inte för det; det spelar ingen roll</ex_transl></ex>
      <ex type="phr"><ex_orig>never you mind</ex_orig><ex_transl>bry dig inte om det du, det ska du inte lägga dig i (informellt)</ex_transl></ex>
    </def>
  </ar>
  <ar>
