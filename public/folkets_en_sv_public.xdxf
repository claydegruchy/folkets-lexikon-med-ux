    </def>
  </ar>
  <ar>
    <k>make</k>
    <def>
      <gr>vb</gr>
      <dtrn>vara</dtrn>
      <dtrn>bli</dtrn>
      <dtrn>utgöra</dtrn>
      <dtrn>utgöra när det läggs ihop</dtrn>
      <ex type="exm"><ex_orig>this makes the tenth time she calls me in the middle of the night</ex_orig><ex_transl>det här är den tionde gången hon ringer till mig mitt i natten</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>make</k>
    <def>
      <gr>vb</gr>
      <dtrn>vara</dtrn>
      <dtrn>utgöra</dtrn>
