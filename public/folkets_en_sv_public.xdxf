      <ex type="exm"><ex_orig>I always get a headache when I feel stressed</ex_orig><ex_transl>jag får alltid huvudvärk när jag känner mig stressad</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>get</k>
    <def>
      <gr>vb</gr>
      <dtrn>få</dtrn>
