      <gr>vb</gr>
      <dtrn>komma över</dtrn>
      <dtrn>komma förbi</dtrn>
      <ex type="phr"><ex_orig>I can&#39;t get over...</ex_orig><ex_transl>jag är så förvånad över att... (informellt)</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>get over</k>
    <def>
      <gr>vb</gr>
      <dtrn>komma över</dtrn>
      <dtrn>övervinna</dtrn>
      <dtrn>hämta sig från</dtrn>
      <ex type="exm"><ex_orig>he has to learn to get over his fear</ex_orig><ex_transl>han måste lära sig att övervinna sin rädsla</ex_transl>      </ex>
      <ex type="exm"><ex_orig>she can&amp;#39;t seem to get over his death</ex_orig><ex_transl>hon verkar inte kunna komma över hans död</ex_transl>      </ex>
      <ex type="exm"><ex_orig>you&amp;#39;ll have to get over this disappointment</ex_orig><ex_transl>du måste komma över den här besvikelsen</ex_transl>      </ex>
      <ex type="phr"><ex_orig>get over an illness</ex_orig><ex_transl>hämta sig från en sjukdom</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>get over</k>
    <def>
      <gr>vb</gr>
      <dtrn>nå fram</dtrn>
