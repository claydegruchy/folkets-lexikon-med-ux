      <dtrn>komma ut</dtrn>
      <ex type="exm"><ex_orig>how did the news about their divorce get out?</ex_orig><ex_transl>hur har nyheten om deras skilsmässa kommit ut?</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>get out</k>
    <def>
      <gr>vb</gr>
      <dtrn>slippa ut</dtrn>
      <dtrn>smita ut</dtrn>
      <ex type="exm"><ex_orig>the dog got out again last night</ex_orig><ex_transl>hunden slapp ut igen i går kväll</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>get over</k>
    <def>
      <gr>vb</gr>
      <dtrn>få överstökad</dtrn>
      <ex type="exm"><ex_orig>I&amp;#39;ll be glad to get the job interview over with</ex_orig><ex_transl>det ska bli skönt att få anställningsintervjun överstökad</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>get over</k>
