  <ar>
    <k>get</k>
    <def>
      <gr>vb</gr>
      <dtrn>få</dtrn>
      <dtrn>ges möjlighet att</dtrn>
      <ex type="exm"><ex_orig>I never get to see you any more</ex_orig><ex_transl>jag får aldrig träffa dig nuförtiden</ex_transl>      </ex>
      <ex type="exm"><ex_orig>if I&amp;#39;m lucky I&amp;#39;ll even get to go sailing one afternoon</ex_orig><ex_transl>om jag har tur kanske jag till och med får möjlighet att segla någon eftermiddag</ex_transl>      </ex>
    </def>
