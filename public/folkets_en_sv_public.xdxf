    </def>
  </ar>
  <ar>
    <k>go over</k>
    <def>
      <gr>vb</gr>
      <dtrn>upprepa</dtrn>
      <ex type="exm"><ex_orig>you&amp;#39;ll simply have to go over it until everybody knows exactly what to do</ex_orig><ex_transl>ni blir helt tvungna att upprepa det tills alla vet precis vad de ska göra</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>go round</k>
    <def>
      <gr>vb</gr>
      <dtrn>gå förbi</dtrn>
      <dtrn>gå förbi på besök i någons hem</dtrn>
      <dtrn>kila över</dtrn>
      <dtrn>gå på besök</dtrn>
      <dtrn>gå på hastigt besök</dtrn>
      <ex type="exm"><ex_orig>let&amp;#39;s go round to the Johnsons tonight</ex_orig><ex_transl>vi kan väl kila över till Johnsons i kväll</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>go round</k>
    <def>
      <gr>vb</gr>
      <dtrn>gå runt</dtrn>
      <dtrn>snurra</dtrn>
