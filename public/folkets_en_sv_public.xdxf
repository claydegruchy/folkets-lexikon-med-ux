      <gr>vb</gr>
      <dtrn>undvika</dtrn>
      <dtrn>kringgå</dtrn>
      <ex type="exm"><ex_orig>let&amp;#39;s try and get round this difficulty</ex_orig><ex_transl>låt oss försöka kringgå den här svårigheten</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
