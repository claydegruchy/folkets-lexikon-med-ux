      <gr>vb</gr>
      <dtrn>avstänga</dtrn>
      <dtrn>isolera</dtrn>
      <ex type="exm"><ex_orig>due to the snow storm we were cut off from the rest of the world</ex_orig><ex_transl>vi blev isolerade från omvärlden på grund av snöstormen</ex_transl>      </ex>
      <ex type="exm"><ex_orig>we&amp;#39;ve cut off the soldiers from their superiors</ex_orig><ex_transl>vi har isolerat soldaterna från deras överordnade</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
