      <ex type="phr"><ex_orig>get the sack</ex_orig><ex_transl>få sparken</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>get</k>
    <def>
      <gr>vb</gr>
      <dtrn>förstå</dtrn>
