      <ex type="exm"><ex_orig>I can&amp;#39;t seem to get the car to start</ex_orig><ex_transl>det verkar inte som om jag får igång bilen</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>get</k>
    <def>
      <gr>vb</gr>
      <dtrn>få</dtrn>
