      <gr>vb</gr>
      <dtrn>lyckas övertala</dtrn>
      <dtrn>lirka med</dtrn>
      <ex type="exm"><ex_orig>don&amp;#39;t worry about her not approving of our idea; I know how to get round her</ex_orig><ex_transl>oroa dig inte över att hon inte gillar vår idé; jag vet hur jag ska lyckas övertala henne</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>get round</k>
    <def>
      <gr>vb</gr>
      <dtrn>spridas</dtrn>
