      <ex type="exm"><ex_orig>I can&amp;#39;t get into this dress anymore</ex_orig><ex_transl>jag kommer inte i den här klänningen längre</ex_transl>      </ex>
      <ex type="phr"><ex_orig>get going!</ex_orig><ex_transl>sätt i gång!</ex_transl></ex>
