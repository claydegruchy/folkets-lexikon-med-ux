      <ex type="exm"><ex_orig>it&amp;#39;s at the back of my mind, but I can&amp;#39;t quite remember it now</ex_orig><ex_transl>jag har det någonstans i bakhuvudet, men jag kan inte riktigt minnas det</ex_transl>      </ex>
      <ex type="exm"><ex_orig>you must bear this in mind</ex_orig><ex_transl>du måste hålla detta i minnet</ex_transl>      </ex>
      <ex type="exm"><ex_orig>you put me in mind of my cousin</ex_orig><ex_transl>du påminner mig om min kusin</ex_transl>      </ex>
      <ex type="phr"><ex_orig>go (right) out of one&#39;s mind</ex_orig><ex_transl>(helt) falla i glömska</ex_transl></ex>
      <ex type="phr"><ex_orig>time out of mind</ex_orig><ex_transl>sedan urminnes tid</ex_transl></ex>
