      <dtrn>straffa</dtrn>
      <ex type="exm"><ex_orig>I&amp;#39;ll get him for that</ex_orig><ex_transl>jag ska nog ge honom, jag</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>get</k>
    <def>
      <gr>vb</gr>
