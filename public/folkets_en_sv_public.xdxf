      <dtrn>slödder</dtrn>
    </def>
  </ar>
  <ar>
    <k>hold against</k>
    <def>
      <gr>vb</gr>
      <dtrn>lägga till last</dtrn>
      <ex type="exm"><ex_orig>he said he wouldn&amp;#39;t hold it against her</ex_orig><ex_transl>han sade att han inte skulle lägga henne till last för det</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold back</k>
    <def>
      <gr>vb</gr>
      <dtrn>dölja</dtrn>
      <dtrn>inte visa</dtrn>
      <ex type="exm"><ex_orig>I held back my disappoint at not being chosen for the job</ex_orig><ex_transl>jag dolde min besvikelse över att inte bli utvald till jobbet</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold back</k>
    <def>
      <gr>vb</gr>
      <dtrn>förhindra utvecklingen av</dtrn>
      <ex type="exm"><ex_orig>her laziness is holding her back from developing as a dancer</ex_orig><ex_transl>hennes lättja hindrar henne från att utvecklas som dansare</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold back</k>
    <def>
      <gr>vb</gr>
      <dtrn>hejda</dtrn>
      <dtrn>hålla tillbaka</dtrn>
      <dtrn>hindra</dtrn>
      <ex type="exm"><ex_orig>don&amp;#39;t hold me back</ex_orig><ex_transl>hindra mig inte</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold back</k>
    <def>
      <gr>vb</gr>
      <dtrn>hemlighålla</dtrn>
      <dtrn>dölja</dtrn>
      <dtrn>undanhålla</dtrn>
      <ex type="exm"><ex_orig>tell me everything-don&amp;#39;t hold back</ex_orig><ex_transl>berätta allt för mig-hemlighåll ingenting</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold back</k>
    <def>
      <gr>vb</gr>
      <dtrn>hemlighålla</dtrn>
      <dtrn>dölja</dtrn>
      <dtrn>undanhålla</dtrn>
      <ex type="exm"><ex_orig>I think he is holding something back from me</ex_orig><ex_transl>jag tror att han döljer någonting för mig</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold back</k>
    <def>
      <gr>vb</gr>
      <dtrn>tveka</dtrn>
      <dtrn>dra sig undan</dtrn>
      <dtrn>förhålla sig litet avvaktande</dtrn>
      <ex type="exm"><ex_orig>the teacher held back from interfering in the fight</ex_orig><ex_transl>läraren avvaktade med att lägga sig i bråket</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold down</k>
    <def>
      <gr>vb</gr>
      <dtrn>behålla</dtrn>
      <ex type="exm"><ex_orig>she can never hold down a job for long</ex_orig><ex_transl>hon lyckas aldrig behålla ett arbete särskilt länge</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold down</k>
    <def>
      <gr>vb</gr>
      <dtrn>förtrycka</dtrn>
      <dtrn>hålla nere</dtrn>
      <ex type="exm"><ex_orig>I was held down by the policeman</ex_orig><ex_transl>jag hölls ned av poliskonstapeln</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold down</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla nere</dtrn>
      <dtrn>kontrollera</dtrn>
      <ex type="exm"><ex_orig>we must try and hold down prices</ex_orig><ex_transl>vi måste försöka hålla priserna nere</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold forth</k>
    <def>
      <gr>vb</gr>
      <dtrn>utbreda sig</dtrn>
      <dtrn>orera</dtrn>
    </def>
  </ar>
  <ar>
    <k>hold off</k>
    <def>
      <gr>vb</gr>
      <dtrn>dröja med att göra något</dtrn>
      <ex type="exm"><ex_orig>they held off from handing in the application</ex_orig><ex_transl>de väntade med att lämna in ansökan</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold off</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla stången</dtrn>
      <dtrn>hålla på avstånd</dtrn>
      <ex type="exm"><ex_orig>so far we&amp;#39;ve managed to hold the enemy off</ex_orig><ex_transl>än så länge har vi lyckats hålla fienden på avstånd</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold off</k>
    <def>
      <gr>vb</gr>
      <dtrn>skjuta upp</dtrn>
      <ex type="exm"><ex_orig>the meeting has been held off</ex_orig><ex_transl>mötet är uppskjutet</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold on</k>
    <def>
      <gr>vb</gr>
      <dtrn>klamra sig fast</dtrn>
      <dtrn>hålla sig fast</dtrn>
      <ex type="exm"><ex_orig>you must hold on-help is on the way</ex_orig><ex_transl>försök hålla dig fast-hjälpen är på väg</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold on</k>
    <def>
      <gr>vb</gr>
      <dtrn>vänta</dtrn>
      <ex type="exm"><ex_orig>could you hold on just a second?</ex_orig><ex_transl>kan du vänta ett litet ögonblick?</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold onto</k>
    <def>
      <gr>vb</gr>
      <dtrn>behålla</dtrn>
      <ex type="exm"><ex_orig>he hasn&amp;#39;t managed to hold onto his job</ex_orig><ex_transl>han har inte lyckats behålla jobbet</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold out for</k>
    <def>
      <gr>vb</gr>
      <dtrn>begära och avvakta tills man fått</dtrn>
      <ex type="exm"><ex_orig>we&amp;#39;re holding out for a better offer</ex_orig><ex_transl>vi avvaktar tills vi får ett bättre erbjudande</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold out on</k>
    <def>
      <gr>vb</gr>
      <dtrn>undanhålla</dtrn>
      <ex type="exm"><ex_orig>why did she hold out on me like that?</ex_orig><ex_transl>varför underlät hon att stöjda mig på det där viset?</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold out</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla ut</dtrn>
      <dtrn>stå ut</dtrn>
      <ex type="exm"><ex_orig>how much longer do you think that he can hold out?</ex_orig><ex_transl>hur länge till tror du att han står ut?</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold out</k>
    <def>
      <gr>vb</gr>
      <dtrn>räcka</dtrn>
      <ex type="exm"><ex_orig>the supplies won&amp;#39;t hold out much longer</ex_orig><ex_transl>provianten räcker inte särskilt länge till</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold out</k>
    <def>
      <gr>vb</gr>
      <dtrn>räcka</dtrn>
      <dtrn>sträcka ut</dtrn>
      <ex type="exm"><ex_orig>she held out her hand to me</ex_orig><ex_transl>hon räckte mig handen</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold over</k>
    <def>
      <gr>vb</gr>
      <dtrn>skjuta upp</dtrn>
      <ex type="exm"><ex_orig>the meeting was held over until tomorrow morning</ex_orig><ex_transl>mötet är uppskjutet till i morgon bitti</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold to</k>
    <def>
      <gr>vb</gr>
      <dtrn>inte tillåta att vara bättre än eller få mer än</dtrn>
      <ex type="exm"><ex_orig>they held the other team to a draw</ex_orig><ex_transl>de såg till att det blev oavgjort i matchen</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold to</k>
    <def>
      <gr>vb</gr>
      <dtrn>vidhålla</dtrn>
      <dtrn>hålla fast vid</dtrn>
      <dtrn>fortsätta att hävda</dtrn>
      <ex type="exm"><ex_orig>she held to her version of what had happened</ex_orig><ex_transl>hon höll fast vid sin version av vad som hade hänt</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold together</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla ihop</dtrn>
      <ex type="exm"><ex_orig>we&amp;#39;ll hold together no matter what</ex_orig><ex_transl>vi kommer att hålla ihop vad som än händer</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold together</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla ihop</dtrn>
      <ex type="exm"><ex_orig>we weren&amp;#39;t able to hold our marriage together</ex_orig><ex_transl>vi lyckades inte hålla ihop vårt äktenskap</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold up</k>
    <def>
      <gr>vb</gr>
      <dtrn>försena</dtrn>
      <dtrn>uppehålla</dtrn>
      <ex type="exm"><ex_orig>we were held up by the fog</ex_orig><ex_transl>vi blev försenade på grund av dimman</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold up</k>
    <def>
      <gr>vb</gr>
      <dtrn>råna</dtrn>
      <dtrn>överfalla och plundra</dtrn>
      <ex type="exm"><ex_orig>two men held up the bank this morning</ex_orig><ex_transl>två män rånade banken i morse</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold up</k>
    <def>
      <gr>vb</gr>
      <dtrn>visa upp som exempel</dtrn>
      <ex type="exm"><ex_orig>my sister is always held up as the epitome of a successful student</ex_orig><ex_transl>min syster visas alltid upp som urtypen för en framgångsrik student</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold with</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla med om</dtrn>
      <dtrn>gilla</dtrn>
      <ex type="exm"><ex_orig>I really don&amp;#39;t hold with his ideas</ex_orig><ex_transl>jag gillar verkligen inte hans idéer</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>bära</dtrn>
      <dtrn>hålla upp i viss position eller visst läge</dtrn>
      <ex type="exm"><ex_orig>hold out your hands</ex_orig><ex_transl>håll fram händerna</ex_transl>      </ex>
      <ex type="exm"><ex_orig>what is holding the roof?</ex_orig><ex_transl>vad är det som håller upp yttertaket?</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>fortfarande gälla</dtrn>
      <ex type="exm"><ex_orig>what they said then still holds as far as I understand</ex_orig><ex_transl>såvitt jag förstår gäller det som de sade då fortfarande</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>nn</gr>
      <dtrn>fäste</dtrn>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>försvara</dtrn>
      <ex type="exm"><ex_orig>our men were able to hold our village for two weeks</ex_orig><ex_transl>våra män lyckades försvara vår by i två veckor</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>nn</gr>
      <dtrn>grepp</dtrn>
      <ex type="exm"><ex_orig>she has a firm hold</ex_orig><ex_transl>han har ett fast grepp</ex_transl>      </ex>
      <ex type="phr"><ex_orig>no holds barred</ex_orig><ex_transl>alla grepp är tillåtna</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>nn</gr>
      <dtrn>grepp</dtrn>
      <dtrn>kontroll</dtrn>
      <dtrn>inflytande</dtrn>
      <dtrn>makt</dtrn>
      <ex type="exm"><ex_orig>I am still struggling to get a good hold of my subject</ex_orig><ex_transl>jag försöker fortfarande få grepp om mitt ämne</ex_transl>      </ex>
      <ex type="phr"><ex_orig>keep something/somebody on hold</ex_orig><ex_transl>låta någonting/någon vänta</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>nn</gr>
      <dtrn>grepp</dtrn>
      <dtrn>tag</dtrn>
      <ex type="exm"><ex_orig>I got hold of a wonderful book yesterday</ex_orig><ex_transl>jag fick tag på en underbar bok i går</ex_transl>      </ex>
      <ex type="phr"><ex_orig>get/take/lay/lose hold of</ex_orig><ex_transl>få/ta/fatta/tappa greppet om</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>ha utrymme för</dtrn>
      <dtrn>rymma</dtrn>
      <ex type="exm"><ex_orig>how many people does this hall hold?</ex_orig><ex_transl>hur många ryms det i den här salen?</ex_transl>      </ex>
      <ex type="exm"><ex_orig>life has certainly held many surprises for me so far</ex_orig><ex_transl>livet har onekligen berett mig många överraskningar hittills</ex_transl>      </ex>
      <ex type="exm"><ex_orig>the box holds a hundred litres</ex_orig><ex_transl>kartongen rymmer hundra liter</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>hysa</dtrn>
      <dtrn>ge uttryck för</dtrn>
      <ex type="exm"><ex_orig>he holds some very strange opinions, I think</ex_orig><ex_transl>jag tycker att han har en del mycket märkliga åsikter</ex_transl>      </ex>
      <ex type="exm"><ex_orig>she held us all responsible for what happened yesterday</ex_orig><ex_transl>hon gav oss alla för det som hände i går</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla en ton</dtrn>
      <dtrn>hålla ut</dtrn>
      <ex type="exm"><ex_orig>she held the high note for several seconds</ex_orig><ex_transl>hon höll den höga tonen i flera sekunder</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla en viss kurs</dtrn>
      <ex type="exm"><ex_orig>the ship holds a southerly course</ex_orig><ex_transl>fartyget håller en sydlig kurs</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla fängslad</dtrn>
      <ex type="exm"><ex_orig>they are holding a man for the murder</ex_orig><ex_transl>de har fängslat en man för mordet</ex_transl>      </ex>
      <ex type="phr"><ex_orig>hold somebody prisoner/hold somebody hostage</ex_orig><ex_transl>hålla fängslad</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla i sig</dtrn>
      <dtrn>vara oförändrad/oförändrat</dtrn>
      <ex type="exm"><ex_orig>if my luck holds I&amp;#39;ll be able to cash in some money by the end of next month</ex_orig><ex_transl>om min tur håller i sig kommer jag att kunna håva in en del pengar i slutet av nästa månad</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla sig eller del av kroppen i viss position</dtrn>
      <dtrn>föra sig</dtrn>
      <ex type="exm"><ex_orig>I held my head high</ex_orig><ex_transl>jag höll huvudet högt</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla tillbaka</dtrn>
      <dtrn>hejda</dtrn>
      <ex type="exm"><ex_orig>they were ordered to hold their fire</ex_orig><ex_transl>de beordrades att inte skjuta</ex_transl>      </ex>
      <ex type="phr"><ex_orig>hold your tongue!</ex_orig><ex_transl>håll tyst!</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla</dtrn>
      <ex type="exm"><ex_orig>she held the baby in her arms</ex_orig><ex_transl>hon höll barnet i sina armar</ex_transl>      </ex>
      <ex type="phr"><ex_orig>be left holding the baby</ex_orig><ex_transl>bli lämnad i sticket (brittisk engelska)</ex_transl></ex>
      <ex type="phr"><ex_orig>be left holding the bag</ex_orig><ex_transl>bli lämnad i sticket (amerikansk engelska)</ex_transl></ex>
      <ex type="phr"><ex_orig>hold all the cards</ex_orig><ex_transl>sitta med trumf</ex_transl></ex>
      <ex type="phr"><ex_orig>hold court</ex_orig><ex_transl>hålla hov (ofta humoristiskt)</ex_transl></ex>
      <ex type="phr"><ex_orig>hold good</ex_orig><ex_transl>hålla, äga giltighet, stå fast, gälla</ex_transl></ex>
      <ex type="phr"><ex_orig>hold hands (with)</ex_orig><ex_transl>hålla (någon) i handen</ex_transl></ex>
      <ex type="phr"><ex_orig>hold it!</ex_orig><ex_transl>vänta!/stanna! (informellt)</ex_transl></ex>
      <ex type="phr"><ex_orig>hold one&#39;s head hig</ex_orig><ex_transl>hålla huvudet högt, visa stolthet och självförtroende (särskilt i svårigheter)</ex_transl></ex>
      <ex type="phr"><ex_orig>hold one&#39;s own</ex_orig><ex_transl>hålla någon stången/kunna mäta sig med någon</ex_transl></ex>
      <ex type="phr"><ex_orig>hold the fort</ex_orig><ex_transl>hålla ställningarna</ex_transl></ex>
      <ex type="phr"><ex_orig>hold your horses!</ex_orig><ex_transl>stopp på belägg!/ta det lugnt! (informellt)</ex_transl></ex>
      <ex type="phr"><ex_orig>not hold a candle to</ex_orig><ex_transl>inte på långt när kunna mäta sig med (informellt)</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla</dtrn>
      <dtrn>hålla sig kvar på/i</dtrn>
      <ex type="exm"><ex_orig>I&amp;#39;m not sure that I will be able to hold my job</ex_orig><ex_transl>jag är inte säker på att jag kommer att kunna behålla jobbet</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>hålla</dtrn>
      <dtrn>vara stark nog för</dtrn>
      <dtrn>hålla för en viss vikt</dtrn>
      <ex type="exm"><ex_orig>I&amp;#39;m not sure this chair will hold me</ex_orig><ex_transl>jag är inte säker på att den här stolen håller för min tyngd</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
      <gr>vb</gr>
      <dtrn>hållas</dtrn>
      <dtrn>anordna</dtrn>
      <dtrn>ordna</dtrn>
      <dtrn>äga rum</dtrn>
      <ex type="exm"><ex_orig>where will tomorrow&amp;#39;s meeting be held?</ex_orig><ex_transl>var kommer mötet att hållas i morgon?</ex_transl>      </ex>
      <ex type="phr"><ex_orig>hold an election</ex_orig><ex_transl>anordna val</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>hold</k>
    <def>
