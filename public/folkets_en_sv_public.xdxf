      <gr>vb</gr>
      <dtrn>resa</dtrn>
      <dtrn>förflytta sig</dtrn>
      <ex type="exm"><ex_orig>we only made a few kilometres that day</ex_orig><ex_transl>vi reste bara några kilometer den dagen</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>make</k>
