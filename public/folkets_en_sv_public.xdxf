      <ex type="exm"><ex_orig>my student has made an interesting discovery</ex_orig><ex_transl>min student har gjort en intressant upptäckt</ex_transl>      </ex>
      <ex type="exm"><ex_orig>they made me an offer I couldn&amp;#39;t refuse</ex_orig><ex_transl>de kom med ett erbjudande jag inte kunde tacka nej till</ex_transl>      </ex>
      <ex type="exm"><ex_orig>you&amp;#39;ll need to make more of an effort</ex_orig><ex_transl>du/ni måste anstränga dig litet mer</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>make</k>
    <def>
      <gr>vb</gr>
      <dtrn>göra</dtrn>
      <dtrn>få att</dtrn>
      <dtrn>få att framträda som</dtrn>
      <ex type="exm"><ex_orig>the picture made him look older</ex_orig><ex_transl>han såg äldre ut på bilden</ex_transl>      </ex>
      <ex type="exm"><ex_orig>this dress makes me look fat</ex_orig><ex_transl>den här klänningen får mig att se tjock ut</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>make</k>
    <def>
      <gr>vb</gr>
      <dtrn>göra</dtrn>
      <dtrn>försätta</dtrn>
      <dtrn>försätta i visst tillstånd</dtrn>
      <dtrn>orsaka</dtrn>
      <ex type="exm"><ex_orig>I&amp;#39;ve been made chief editor</ex_orig><ex_transl>jag har blivit chefredaktör</ex_transl>      </ex>
      <ex type="exm"><ex_orig>she wasn&amp;#39;t able to make herself heard in the crowd</ex_orig><ex_transl>hon lyckades inte göra sig hörd i folkmassan</ex_transl>      </ex>
      <ex type="exm"><ex_orig>the food made me ill</ex_orig><ex_transl>jag blev sjuk av maten</ex_transl>      </ex>
      <ex type="phr"><ex_orig>make a man of him</ex_orig><ex_transl>göra karl av någon</ex_transl></ex>
      <ex type="phr"><ex_orig>make a fool of oneself</ex_orig><ex_transl>göra sig till åtlöje</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>make</k>
    <def>
      <gr>vb</gr>
      <dtrn>göra</dtrn>
      <dtrn>göra hel</dtrn>
      <dtrn>ge särskilda kvaliteter</dtrn>
      <dtrn>ge någonting det där lilla extra</dtrn>
      <ex type="exm"><ex_orig>a different carpet would make the room</ex_orig><ex_transl>en annan matta skulle tillföra rummet det där lilla extra</ex_transl>      </ex>
      <ex type="exm"><ex_orig>this will really make my day</ex_orig><ex_transl>det här kommer jag att leva på hela dagen</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>make</k>
