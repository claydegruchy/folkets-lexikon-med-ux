      <gr>vb</gr>
      <dtrn>skapa</dtrn>
      <dtrn>producera</dtrn>
      <dtrn>göra</dtrn>
      <dtrn>tillverka</dtrn>
      <ex type="exm"><ex_orig>I am making a doll</ex_orig><ex_transl>jag håller på att göra en docka</ex_transl>      </ex>
      <ex type="exm"><ex_orig>I thought I&amp;#39;d make some tea; would you like a cup?</ex_orig><ex_transl>jag tänkte göra litet te; vill du ha en kopp?</ex_transl>      </ex>
      <ex type="phr"><ex_orig>be made of money</ex_orig><ex_transl>vara gjord av pengar (ha väldigt mycket pengar)</ex_transl></ex>
      <ex type="phr"><ex_orig>make time</ex_orig><ex_transl>avsätta tid</ex_transl></ex>
      <ex type="phr"><ex_orig>see what somebody is really made of</ex_orig><ex_transl>se vad någon går för</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>make</k>
    <def>
      <gr>nn</gr>
      <dtrn>tillverkning</dtrn>
      <dtrn>fabrikat</dtrn>
      <ex type="exm"><ex_orig>what make is it?</ex_orig><ex_transl>vilket fabrikat är den/det?</ex_transl>      </ex>
      <ex type="phr"><ex_orig>on the make</ex_orig><ex_transl>vara vinningslysten, vara streberaktig (nedsättande)</ex_transl></ex>
      <ex type="phr"><ex_orig>on the make</ex_orig><ex_transl>vara ute efter sex, ragga på någon (nedsättande)</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>make</k>
