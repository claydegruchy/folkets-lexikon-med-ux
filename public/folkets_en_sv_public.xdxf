      <ex type="exm"><ex_orig>she got through the scholarship in less than two months</ex_orig><ex_transl>hon använde upp stipendiet på mindre än två månader</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>get through</k>
