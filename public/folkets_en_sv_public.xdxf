      <ex type="exm"><ex_orig>our phone line was cut off two weeks ago</ex_orig><ex_transl>vår telefon stängdes av för två veckor sedan</ex_transl>      </ex>
      <ex type="exm"><ex_orig>we were cut off all of a sudden</ex_orig><ex_transl>plötsligt blev vi avbrutna</ex_transl>      </ex>
      <ex type="phr"><ex_orig>cut off the electricity</ex_orig><ex_transl>stänga av elen</ex_transl></ex>
    </def>
  </ar>
  <ar>
