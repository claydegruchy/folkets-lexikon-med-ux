  <ar>
    <k>get</k>
    <def>
      <gr>vb</gr>
      <dtrn>bli</dtrn>
      <ex type="exm"><ex_orig>I&amp;#39;m so gald you&amp;#39;re getting better again</ex_orig><ex_transl>jag är så glad att du är på bättringsvägen</ex_transl>      </ex>
      <ex type="exm"><ex_orig>it&amp;#39;s getting colder again</ex_orig><ex_transl>det håller på att bli kallare igen</ex_transl>      </ex>
      <ex type="phr"><ex_orig>get carried away</ex_orig><ex_transl>förivra sig</ex_transl></ex>
      <ex type="phr"><ex_orig>get caught</ex_orig><ex_transl>fastna</ex_transl></ex>
      <ex type="phr"><ex_orig>get caught</ex_orig><ex_transl>bli avslöjad; bli ertappad</ex_transl></ex>
      <ex type="phr"><ex_orig>get done</ex_orig><ex_transl>bli klar</ex_transl></ex>
      <ex type="phr"><ex_orig>get lost</ex_orig><ex_transl>gå vilse</ex_transl></ex>
      <ex type="phr"><ex_orig>get lost!</ex_orig><ex_transl>försvinn! (informellt)</ex_transl></ex>
      <ex type="phr"><ex_orig>get married</ex_orig><ex_transl>gifta sig (bli gift)</ex_transl></ex>
      <ex type="phr"><ex_orig>get robbed</ex_orig><ex_transl>bli rånad</ex_transl></ex>
      <ex type="phr"><ex_orig>get stuck</ex_orig><ex_transl>fastna</ex_transl></ex>
      <ex type="phr"><ex_orig>get stuck</ex_orig><ex_transl>haka upp sig</ex_transl></ex>
      <ex type="phr"><ex_orig>get worried</ex_orig><ex_transl>bli orolig</ex_transl></ex>
