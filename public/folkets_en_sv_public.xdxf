  <ar>
    <k>go</k>
    <def>
      <gr>vb</gr>
      <dtrn>bli försvagad</dtrn>
      <dtrn>skadad</dtrn>
      <dtrn>eller förstörd</dtrn>
      <ex type="exm"><ex_orig>my winter boots are beginning to go</ex_orig><ex_transl>mina vinterstövlar håller på att ta slut</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>go</k>
    <def>
      <gr>vb</gr>
      <dtrn>börja en aktivitet</dtrn>
      <dtrn>sätta igång</dtrn>
      <ex type="exm"><ex_orig>they are ready to go whenever you are</ex_orig><ex_transl>de är redo att börja närhelst du är det</ex_transl>      </ex>
      <ex type="phr"><ex_orig>get going</ex_orig><ex_transl>sätta i gång</ex_transl></ex>
      <ex type="phr"><ex_orig>get going!</ex_orig><ex_transl>sätt i gång!</ex_transl></ex>
      <ex type="phr"><ex_orig>ready, steady, go!</ex_orig><ex_transl>klara, färdiga, gå!</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>go</k>
    <def>
      <gr>vb</gr>
      <dtrn>dö</dtrn>
      <ex type="exm"><ex_orig>his wife is gone now</ex_orig><ex_transl>nu har hans fru dött</ex_transl>      </ex>
      <ex type="phr"><ex_orig>dead and gone</ex_orig><ex_transl>död och begraven</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>go</k>
    <def>
      <gr>nn</gr>
      <dtrn>framåtanda</dtrn>
      <ex type="exm"><ex_orig>there&amp;#39;s no real go in her</ex_orig><ex_transl>hon har ingen riktig framåtanda</ex_transl>      </ex>
      <ex type="phr"><ex_orig>be full of go</ex_orig><ex_transl>ha mycket framåtanda i sig</ex_transl></ex>
      <ex type="phr"><ex_orig>be on the go</ex_orig><ex_transl>vara i farten</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>go</k>
    <def>
      <gr>vb</gr>
      <dtrn>försvinna</dtrn>
      <dtrn>ta slut</dtrn>
      <dtrn>få sluta</dtrn>
      <ex type="exm"><ex_orig>fifty people will have to go next year</ex_orig><ex_transl>femtio personer kommer att bli uppsagda nästa år</ex_transl>      </ex>
      <ex type="exm"><ex_orig>there goes all my money</ex_orig><ex_transl>där gick mina sista slantar</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>go</k>
    <def>
      <gr>nn</gr>
      <dtrn>försök</dtrn>
      <ex type="exm"><ex_orig>let me have a go at opening that bottle now that you&amp;#39;ve tried</ex_orig><ex_transl>låt mig försöka öppna flaskan nu när du har gjort ett försök</ex_transl>      </ex>
      <ex type="phr"><ex_orig>have a go</ex_orig><ex_transl>göra ett försök</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>go</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge sig av</dtrn>
      <dtrn>avlägsna sig</dtrn>
      <dtrn>ge sig iväg</dtrn>
      <ex type="exm"><ex_orig>I should be going now</ex_orig><ex_transl>jag borde ge mig iväg nu</ex_transl>      </ex>
      <ex type="phr"><ex_orig>be gone</ex_orig><ex_transl>vara borta; vara försvunnen</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>go</k>
    <def>
      <gr>vb</gr>
      <dtrn>ge sig iväg för att utföra viss specificerad aktivitet</dtrn>
      <ex type="exm"><ex_orig>he has gone fishing</ex_orig><ex_transl>han är ute och fiskar</ex_transl>      </ex>
      <ex type="phr"><ex_orig>go dancing/diving/sailing/shopping/skiing/swimming etcetera</ex_orig><ex_transl>gå ut och dansa/ge sig iväg för att dyka/sticka ut och segla/gå ut på shoppingronda/ge sig ut och åka skidor/gå och simma etctera</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>go</k>
    <def>
      <gr>vb</gr>
      <dtrn>gå omkring och vara</dtrn>
      <ex type="exm"><ex_orig>after the break-in she went in fear of her life</ex_orig><ex_transl>efter inbrottet fruktade hon för sitt liv</ex_transl>      </ex>
      <ex type="phr"><ex_orig>go hungry</ex_orig><ex_transl>gå hungrig; gå omkring och vara hungrig</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>go</k>
    <def>
      <gr>vb</gr>
      <dtrn>gå</dtrn>
      <ex type="exm"><ex_orig>seven goes into 21 three times</ex_orig><ex_transl>tjugoett delat med sju är tre; tjugoett är jämnt delbart med sju och tre</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>go</k>
    <def>
      <gr>vb</gr>
      <dtrn>gå</dtrn>
      <dtrn>leda</dtrn>
      <dtrn>nå</dtrn>
      <ex type="exm"><ex_orig>this path goes to the lake</ex_orig><ex_transl>den här stigen leder till sjön</ex_transl>      </ex>
      <ex type="phr"><ex_orig>go far</ex_orig><ex_transl>gå långt; nå långt, lyckas</ex_transl></ex>
      <ex type="phr"><ex_orig>go far</ex_orig><ex_transl>räcka till mycket</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>go</k>
    <def>
      <gr>vb</gr>
      <dtrn>gå</dtrn>
      <dtrn>förlöpa</dtrn>
      <ex type="exm"><ex_orig>how did your meeting go?</ex_orig><ex_transl>hur gick mötet?</ex_transl>      </ex>
      <ex type="exm"><ex_orig>our party last night went really well</ex_orig><ex_transl>vår fest i går blev riktigt lyckad</ex_transl>      </ex>
      <ex type="phr"><ex_orig>how are things going?</ex_orig><ex_transl>hur är det?</ex_transl></ex>
      <ex type="phr"><ex_orig>how&#39;s it going?</ex_orig><ex_transl>hur är det?</ex_transl></ex>
      <ex type="phr"><ex_orig>how goes it?</ex_orig><ex_transl>hur står det till? (gammaldags)</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>go</k>
    <def>
      <gr>vb</gr>
      <dtrn>gå</dtrn>
      <dtrn>lyda</dtrn>
      <ex type="exm"><ex_orig>can you remember how that poem goes?</ex_orig><ex_transl>kommer du ihåg den där dikten?</ex_transl>      </ex>
      <ex type="exm"><ex_orig>I wish I knew how that song goes</ex_orig><ex_transl>jag önskar att jag kunde komma ihåg hur den där sången går</ex_transl>      </ex>
      <ex type="exm"><ex_orig>she didn&amp;#39;t know how the first few lines went</ex_orig><ex_transl>hon visste inte hur de första raderna lydde</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>go</k>
    <def>
      <gr>vb</gr>
      <dtrn>gälla</dtrn>
      <dtrn>accepteras</dtrn>
      <ex type="exm"><ex_orig>as long as I am in charge, everything I say goes</ex_orig><ex_transl>så länge det är jag som har ansvaret är det jag som bestämmer</ex_transl>      </ex>
      <ex type="phr"><ex_orig>anything goes</ex_orig><ex_transl>allt är tillåtet</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>go</k>
    <def>
