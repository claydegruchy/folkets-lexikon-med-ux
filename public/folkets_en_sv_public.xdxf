      <ex type="exm"><ex_orig>can you get things ready in time for the party?</ex_orig><ex_transl>kan du se till att ordna allting innan festen börjar?</ex_transl>      </ex>
      <ex type="phr"><ex_orig>get oneself down</ex_orig><ex_transl>bli nedstämd</ex_transl></ex>
      <ex type="phr"><ex_orig>get oneself together</ex_orig><ex_transl>samla sig; organisera sig; få ordning på sig själv</ex_transl></ex>
      <ex type="phr"><ex_orig>get ready</ex_orig><ex_transl>göra sig i ordning</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>get</k>
