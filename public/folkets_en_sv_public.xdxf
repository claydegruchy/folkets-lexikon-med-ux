      <gr>vb</gr>
      <dtrn>gå igenom</dtrn>
      <ex type="exm"><ex_orig>I don&amp;#39;t know how many times I&amp;#39;ve gone through this list</ex_orig><ex_transl>jag vet inte hur många gånger jag har gått igenom listan</ex_transl>      </ex>
    </def>
