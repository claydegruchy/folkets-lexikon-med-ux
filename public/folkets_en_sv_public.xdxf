  <ar>
    <k>get</k>
    <def>
      <gr>vb</gr>
      <dtrn>träffa</dtrn>
      <dtrn>skada</dtrn>
      <ex type="exm"><ex_orig>I got him right on the nose</ex_orig><ex_transl>jag träffade honom rakt på näsan</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>get</k>
    <def>
      <gr>vb</gr>
      <dtrn>anlända</dtrn>
      <dtrn>komma fram</dtrn>
      <dtrn>komma fram till</dtrn>
