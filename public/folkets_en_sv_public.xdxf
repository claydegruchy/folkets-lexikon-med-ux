      <ex type="exm"><ex_orig>this food has gone bad</ex_orig><ex_transl>min syster har gjort konkurs</ex_transl>      </ex>
      <ex type="exm"><ex_orig>my sister has gone bankrupt</ex_orig><ex_transl>den här maten har blivit dålig</ex_transl>      </ex>
      <ex type="phr"><ex_orig>go blind/grey/mad</ex_orig><ex_transl>bli blind/gråhårig/galen</ex_transl></ex>
    </def>
