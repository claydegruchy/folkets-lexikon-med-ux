  <ar>
    <k>cut oneself</k>
    <def>
      <gr>vb</gr>
      <dtrn>skära sig</dtrn>
      <ex type="exm"><ex_orig>I cut myself on the broken mirror</ex_orig><ex_transl>jag skar mig på den trasiga spegeln</ex_transl>      </ex>
      <ex type="phr"><ex_orig>he always cuts himself shaving</ex_orig><ex_transl>han skär sig alltid när han rakar sig</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>cut out</k>
    <def>
      <gr>vb</gr>
      <dtrn>klippa ut</dtrn>
      <dtrn>skära ut</dtrn>
      <ex type="exm"><ex_orig>I cut out an article that I think you&amp;#39;ll find interesting</ex_orig><ex_transl>jag har klippt ut en artikel som jag tror skulle intressera dig</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>cut out</k>
    <def cmt="informellt">
      <gr>vb</gr>
      <dtrn>låta bli</dtrn>
      <dtrn>sluta med</dtrn>
      <ex type="exm"><ex_orig>I must cut out alcohol</ex_orig><ex_transl>jag måste sluta med alkohol</ex_transl>      </ex>
      <ex type="phr"><ex_orig>I had my work cut out for me over the next ten months</ex_orig><ex_transl>jag hade fullt upp att göra under de följande tio månaderna (informellt)</ex_transl></ex>
      <ex type="phr"><ex_orig>cut it out!</ex_orig><ex_transl>lägg av! (informellt)</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>cut somebody in</k>
    <def>
      <gr>vb</gr>
      <dtrn>låta någon vara med och dela</dtrn>
      <dtrn>låta någon vara med och dela på en vinst</dtrn>
      <ex type="exm"><ex_orig>I think we should cut him in on the profit</ex_orig><ex_transl>jag tycker att vi ska låta honom vara med och dela på vinsten</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
