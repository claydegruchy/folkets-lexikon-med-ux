      <gr>vb</gr>
      <dtrn>genomsöka</dtrn>
      <ex type="exm"><ex_orig>I&amp;#39;ve gone through my purse four times, and the wallet simply isn&amp;#39;t in there</ex_orig><ex_transl>nu har jag sökt igenom handväskan fyra gånger, och plånboken ligger helt enkelt inte där</ex_transl>      </ex>
    </def>
