      <ex type="exm"><ex_orig>I need to get my clothes from the dry-cleaner&amp;#39;s</ex_orig><ex_transl>jag måste hämta min kemtvätt</ex_transl>      </ex>
      <ex type="exm"><ex_orig>can you come and get me from the doctor&amp;#39;s this afternoon?</ex_orig><ex_transl>kan du hämta mig hos läkaren i eftermiddag?</ex_transl>      </ex>
    </def>
  </ar>
  <ar>
    <k>get</k>
