      <dtrn>orsaka</dtrn>
      <dtrn>få</dtrn>
      <dtrn>få någon att</dtrn>
      <dtrn>tvinga</dtrn>
      <ex type="exm"><ex_orig>you can&amp;#39;t make me do it!</ex_orig><ex_transl>du kan inte tvinga mig att göra det!</ex_transl>      </ex>
      <ex type="exm"><ex_orig>they made me wait for two hours</ex_orig><ex_transl>jag blev tvungen att vänta i två timmar</ex_transl>      </ex>
      <ex type="phr"><ex_orig>make somebody cry/laugh/smile</ex_orig><ex_transl>få någon att gråta/skratta/le</ex_transl></ex>
    </def>
  </ar>
  <ar>
    <k>make</k>
    <def>
      <gr>vb</gr>
      <dtrn>nå</dtrn>
      <dtrn>hinna</dtrn>
      <ex type="exm"><ex_orig>did you make it home all right?</ex_orig><ex_transl>kom du/ni hem ordentligt?</ex_transl>      </ex>
      <ex type="exm"><ex_orig>this scandal has made the tabloids</ex_orig><ex_transl>den här skandalen har hamnat i tabloidpressen</ex_transl>      </ex>
      <ex type="exm"><ex_orig>will you make it to my party?</ex_orig><ex_transl>hinner du komma på min fest?</ex_transl>      </ex>
      <ex type="phr"><ex_orig>make it</ex_orig><ex_transl>hinna i tid</ex_transl></ex>
      <ex type="phr"><ex_orig>make it</ex_orig><ex_transl>lyckas, ha framgång</ex_transl></ex>
    </def>
